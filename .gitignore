# SvelteKit: the dev server's generated dir, plus the one each other command
# owns so it never writes into a live one (`KIT_OUTDIR`, see vitest.config.ts)
.svelte-kit*/
build/
dist/
.output/

# Node
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.test
.env.*.local

# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js
.next/

# TypeScript
*.tsbuildinfo

# Temporary folders
tmp/
temp/

# IDEs
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Prisma
frontend/prisma/generated/
/garage/meta/
/garage/data/

# Local file storage
storage/

# Load-test manifest: generated by `load/run.sh manifest`, contains real PII
# (student/staff emails). Regenerate locally; never commit.
load/data.json

# My stuff
frontend/scripts/list-workspace-context.ts
frontend/scripts/seed-talent-notes-montpellier.ts
frontend/scripts/seed-strasbourg-demo.ts
frontend/scripts/set-montpellier-event-public-names.ts
frontend/scripts/set-strasbourg-event-public-names.ts

# Local docs
docs/
refonte-*

# Playwright reports and test results
playwright-report/
test-results/
frontend/playwright-report/
frontend/test-results/

# Per-role Playwright sessions, written by tests/e2e/auth.setup.ts on every run.
# Real (if throwaway) session cookies: generated, never committed.
frontend/tests/e2e/.auth/



# Working copy for commit messages, PR and issue bodies (see .github/CONTRIBUTING.md
# step 7). Handed to `git commit -F` and to finish-work.sh so multi-line markdown
# survives the shell; never part of a change.
.ship/
