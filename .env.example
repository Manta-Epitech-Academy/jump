# Database
DATABASE_URL="postgresql://jump:password@localhost:5432/jump"
POSTGRES_PASSWORD=password

# App
PORT=3030
ORIGIN=http://localhost:3030

# BetterAuth
BETTER_AUTH_SECRET=

# Microsoft OAuth (Staff login)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Discord OAuth (Student account linking)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Resend (Student OTP emails + interview iCalendar invites in email mode)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Jump <noreply@jump.fr>"

# Dev-only override for ALL outbound mail. Comma-separated list of email
# addresses. When set, every email sent through Resend (broadcasts, OTP,
# relances, calendar invites…) is rerouted to these addresses instead of
# the real recipient. cc/bcc are dropped, and the subject is prefixed with
# the intended recipient `[→ original@…]` for visibility.
# LEAVE EMPTY IN PRODUCTION — unset = real recipients.
EMAIL_DEV_RECIPIENTS=

# Interview calendar sync backend.
#   email (default) — send iCalendar invites (METHOD:REQUEST) via Resend.
#                     No extra OAuth scope; works for every staff regardless
#                     of tenant policy.
#   graph           — push directly to user's Outlook via Microsoft Graph.
#                     Smoother UX, but needs `Calendars.ReadWrite` scope
#                     which Epitech tenants gate behind admin consent.
#                     Opt in only once consent is granted.
#   off             — disable sync entirely (UI controls hide).
INTERVIEW_SYNC_MODE=email

# Dev-only override (email mode). When set, every interview invite is
# rerouted to this address regardless of the seeded recipient. The original
# recipient is kept inside the iCalendar ATTENDEE field and prefixed in
# the subject `[→ original@…]`. Useful when seed data uses fake mailboxes.
# LEAVE EMPTY IN PRODUCTION.
INTERVIEW_SYNC_DEV_REDIRECT=

# Security token for background jobs (API /api/jobs/*)
CRON_SECRET=

# Security token for worker API (API /api/worker/*)
WORKER_API_TOKEN=

# GitHub PAT — needed to read the private ref_comp repository (and any private
# subject repos). A fine-grained PAT with read-only Contents access on the
# Manta-Epitech-Academy organisation is enough. Optional for public repos but
# recommended to raise the rate limit from 60/h to 5000/h.
GITHUB_TOKEN=

# Garage S3 Storage
S3_ENDPOINT=http://localhost:3900
# Endpoint used when signing URLs for the browser. Must be resolvable from the client.
# If unset, falls back to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Default bucket for documents written via getStorage() (onboarding PDFs, etc.)
S3_BUCKET=jump-files

# Garage Admin API (used by bun run garage:generate)
GARAGE_ADMIN_ENDPOINT=http://localhost:3903
GARAGE_ADMIN_TOKEN=dev-admin-token

# jump-games (mini-jeux) — see MINIGAMES.md
# JUMP_GAMES_SECRET is the shared HMAC key used both to sign the JWT (jump → jump-games)
# and verify the callback signature (jump-games → jump). Must equal JWT_INTRA_SECRET AND
# CALLBACK_SECRET on the jump-games side (both can be set to the same value there).
JUMP_GAMES_URL=
JUMP_GAMES_SECRET=

# Umami analytics (client-side). The host is hardcoded in svelte.config.js +
# Umami.svelte (constant across all environments, baked in CSP). Set the
# website ID per environment to activate the tracker. Leave PUBLIC_UMAMI_RECORDER
# unset to disable session recording.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_RECORDER=
