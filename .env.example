# Database
DATABASE_URL="postgresql://jump:password@localhost:5432/jump"
POSTGRES_PASSWORD=password

# App
PORT=3030
ORIGIN=http://localhost:3030

# BetterAuth
BETTER_AUTH_SECRET=

# Microsoft OAuth (Staff login)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Discord OAuth (Student account linking)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Transactional mail provider. Picks the backend used by every outbound
# email (broadcasts, OTP login codes, relances, interview iCalendar invites
# in email mode, etc.).
#   resend  (default) — uses the official SDK. Requires RESEND_API_KEY.
#   mailjet           — REST v3.1 Send API via fetch. Requires
#                       MAILJET_API_KEY + MAILJET_API_SECRET.
MAIL_PROVIDER=resend

# Sender address for transactional emails. Provider-agnostic — used by
# whichever MAIL_PROVIDER is active. Falls back to RESEND_FROM_EMAIL when
# unset (legacy compatibility).
MAIL_FROM="Jump <noreply@jump.fr>"

# Resend credentials. Only read when MAIL_PROVIDER=resend.
RESEND_API_KEY=
# Legacy alias for MAIL_FROM, kept for back-compat. Remove once every
# environment defines MAIL_FROM.
RESEND_FROM_EMAIL=

# Mailjet credentials. Only read when MAIL_PROVIDER=mailjet. Both must be
# set together — the API uses HTTP Basic auth combining them.
MAILJET_API_KEY=
MAILJET_API_SECRET=

# ── THE OUTBOUND GATE ───────────────────────────────────────────────────────
# Single switch deciding whether outbound comms (email AND SMS) reach real
# people. FAIL-SAFE: the only value that allows real sends is exactly `real`;
# anything else — unset, blank, a typo — means `redirect` (trapped). So a
# forgotten var never mails/texts a minor (RGPD); the worst case is real users
# not getting mail, never the reverse.
#   SET `OUTBOUND_MODE=real` IN PRODUCTION ONLY. Leave unset everywhere else.
# When trapped, where a copy lands is resolved per-send (per-staff lists in the
# admin settings dialog, then the *_DEV_RECIPIENTS fallbacks below).
OUTBOUND_MODE=

# Fallback destination for trapped outbound MAIL — comma-separated addresses.
# NO LONGER A GATE (that's OUTBOUND_MODE above): this is only the catch-all for
# trapped sends with no better target (headless cron, logged-out OTP). Sends
# with an acting staff member route to their personal list / login email first.
# A trapped mail with no destination at all is DROPPED, never sent for real.
# The subject is prefixed with the intended recipient `[→ original@…]`.
EMAIL_DEV_RECIPIENTS=

# Transactional SMS provider. Powers the SMS escalation step of onboarding
# relances (and the SMS broadcast channel). Lives behind a façade in
# $lib/server/sms — flip the env to swap the backend, no code change.
#   null  (default) — no provider wired; sends fail loud so an unconfigured
#                     prod surfaces "0 envoyés / N échecs" instead of a silent
#                     success. The SMS channel is disabled in the relance UI.
#   brevo           — Brevo (ex-Sendinblue) transactional SMS REST API via
#                     fetch. Requires BREVO_API_KEY.
SMS_PROVIDER=null

# Brevo credentials. Only read when SMS_PROVIDER=brevo.
BREVO_API_KEY=

# Alphanumeric sender name shown on the handset. Brevo caps it at 11 chars
# (longer values are rejected); defaults to "Epitech" when unset.
SMS_SENDER=Epitech

# Fallback destination for trapped outbound SMS — comma-separated numbers;
# every listed number receives a copy (one SMS each), with the intended number
# prepended to the body (same fan-out as EMAIL_DEV_RECIPIENTS). NO LONGER A GATE
# (that's OUTBOUND_MODE): only the catch-all when no per-staff number resolves.
# A trapped SMS with no destination is DROPPED, never texted for real — staff
# accounts carry no phone, so set this on any non-prod env that sends SMS.
SMS_DEV_RECIPIENTS=

# Interview calendar sync backend.
#   email (default) — send iCalendar invites (METHOD:REQUEST) via the
#                     active MAIL_PROVIDER. No extra OAuth scope; works
#                     for every staff regardless of tenant policy.
#   graph           — push directly to user's Outlook via Microsoft Graph.
#                     Smoother UX, but needs `Calendars.ReadWrite` scope
#                     which Epitech tenants gate behind admin consent.
#                     Opt in only once consent is granted.
#   off             — disable sync entirely (UI controls hide).
INTERVIEW_SYNC_MODE=email

# Dev-only override (email mode). When set, every interview invite is
# rerouted to this address regardless of the seeded recipient. The original
# recipient is kept inside the iCalendar ATTENDEE field and prefixed in
# the subject `[→ original@…]`. Useful when seed data uses fake mailboxes.
# LEAVE EMPTY IN PRODUCTION.
INTERVIEW_SYNC_DEV_REDIRECT=

# Security token for background jobs (API /api/jobs/*)
CRON_SECRET=

# Security token for worker API (API /api/worker/*)
WORKER_API_TOKEN=

# GitHub PAT — needed to read the private ref_comp repository (and any private
# subject repos). A fine-grained PAT with read-only Contents access on the
# Manta-Epitech-Academy organisation is enough. Optional for public repos but
# recommended to raise the rate limit from 60/h to 5000/h.
GITHUB_TOKEN=

# Garage S3 Storage
S3_ENDPOINT=http://localhost:3900
# Endpoint used when signing URLs for the browser. Must be resolvable from the client.
# If unset, falls back to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Default bucket for documents written via getStorage() (onboarding PDFs, etc.)
S3_BUCKET=jump-files

# Garage Admin API (used by bun run garage:generate)
GARAGE_ADMIN_ENDPOINT=http://localhost:3903
GARAGE_ADMIN_TOKEN=dev-admin-token

# jump-games (mini-jeux) — see INTEGRATION.md in the jump-games repo:
# https://github.com/Manta-Epitech-Academy/jump-games/blob/main/INTEGRATION.md
# JUMP_GAMES_SECRET is the shared HMAC key used both to sign the JWT (jump → jump-games)
# and verify the callback signature (jump-games → jump). Must equal JWT_INTRA_SECRET AND
# CALLBACK_SECRET on the jump-games side (both can be set to the same value there).
JUMP_GAMES_URL=
JUMP_GAMES_SECRET=

# Umami analytics (client-side). The host is hardcoded in svelte.config.js +
# Umami.svelte (constant across all environments, baked in CSP). Set the
# website ID per environment to activate the tracker. Leave PUBLIC_UMAMI_RECORDER
# unset to disable session recording.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_RECORDER=
