# Environment for the integration and E2E suites. Copy to `.env.test` (gitignored).
#
# Loaded by `scripts/with-test-db.sh`, which every test command that needs a real
# database goes through (`bun run test:integration`, `bun run test:e2e`,
# `bun run test:db`). The file is read by `sh` as well as by bun, so keep it to
# plain `KEY="value"` lines: no `export`, no interpolation.
#
# NO DATABASE_URL HERE, on purpose. The wrapper computes it, one database per
# worktree, and exports it last so it wins over this file and over the repo-root
# `.env`. A DATABASE_URL written here would be silently overridden, which is
# worse than absent.

# ── The server the E2E suite drives ─────────────────────────────────────────
# Playwright builds and boots the real node server (same command locally and in
# CI). ORIGIN must match the port: BetterAuth derives its base URL from it.
PORT="4173"
ORIGIN="http://localhost:4173"
PLAYWRIGHT_BASE_URL="http://localhost:4173"
BETTER_AUTH_SECRET="e2e-only-secret-not-used-anywhere-real"

# Mints the Playwright session cookies through `/api/test/login-as`, the existing
# load-test endpoint: it 404s unless this is set server-side, so the E2E suite
# arms it for its own throwaway server and nothing else does.
LOAD_TEST_SECRET="e2e-only-load-test-secret"

# Never reached: staff log in through `/api/test/login-as`, not through OAuth.
# Present because `$lib/server/auth` evaluates them when the module loads.
MICROSOFT_CLIENT_ID="e2e-dummy"
MICROSOFT_CLIENT_SECRET="e2e-dummy"
MICROSOFT_TENANT_ID="e2e-dummy"
RESEND_API_KEY="e2e-dummy"
RESEND_FROM_EMAIL="noreply@e2e.invalid"

# Outbound stays trapped. `redirect` is the fail-safe default, restated here so a
# test run can never be the thing that mails a minor.
OUTBOUND_MODE="redirect"
