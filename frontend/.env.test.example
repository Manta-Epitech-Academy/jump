# Environment for the integration and E2E suites. Copy to `.env.test` (gitignored).
#
# Loaded by `scripts/with-test-db.sh`, which every test command that needs a real
# database goes through (`bun run test:integration`, `bun run test:e2e`,
# `bun run test:db`). The file is read by `sh` as well as by bun, so keep it to
# plain `KEY="value"` lines: no `export`, no interpolation.
#
# NO DATABASE_URL, PORT OR ORIGIN HERE, on purpose. The wrapper computes all of
# them, one database and one port per worktree, and exports them last so they win
# over this file and over the repo-root `.env`. A value written here would be
# silently overridden, which is worse than absent.
#
# The port used to live here, and that is exactly how it went wrong: every
# worktree copied the same `PORT=4173`, so two gates running at once bound one
# server and one of them tested the other's build. ORIGIN is derived from the
# port in the same place, because BetterAuth reads it as its base URL and the two
# drifting apart gives you an app that boots and then fails every session.

# ── The server the E2E suite drives ─────────────────────────────────────────
# Playwright builds and boots the real node server, on the port the wrapper
# hands it (same command locally and in CI).
BETTER_AUTH_SECRET="e2e-only-secret-not-used-anywhere-real"

# Mints the Playwright session cookies through `/api/test/login-as`, the existing
# load-test endpoint: it 404s unless this is set server-side, so the E2E suite
# arms it for its own throwaway server and nothing else does.
LOAD_TEST_SECRET="e2e-only-load-test-secret"

# Reached for real, so do not drop them: `microsoftOAuthCallback.integration.test.ts`
# drives a Microsoft OAuth round-trip through BetterAuth and posts these to the
# token endpoint of a LOCAL fake server standing in for login.microsoftonline.com
# (the tenant is overridden per test). No real Microsoft endpoint is ever
# contacted, and the E2E suite still never signs in through OAuth: staff sessions
# come from `/api/test/login-as`.
MICROSOFT_CLIENT_ID="e2e-dummy"
MICROSOFT_CLIENT_SECRET="e2e-dummy"
MICROSOFT_TENANT_ID="e2e-dummy"

# Never reached: outbound is trapped below, and `$lib/server/email/config` only
# reads the from-address when the module loads.
RESEND_API_KEY="e2e-dummy"
RESEND_FROM_EMAIL="noreply@e2e.invalid"

# Outbound stays trapped. `redirect` is the fail-safe default, restated here so a
# test run can never be the thing that mails a minor.
OUTBOUND_MODE="redirect"
