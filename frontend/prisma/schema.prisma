model ActivityTheme {
  activityId String
  themeId    String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([activityId, themeId])
}

model Event {
  id         String    @id @default(cuid())
  titre      String
  date       DateTime
  endDate    DateTime?
  eventType  String    @default("coding_club")
  campusId   String
  themeId    String?
  pin        String?
  notes      String?
  externalId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  campus           Campus                  @relation(fields: [campusId], references: [id])
  theme            Theme?                  @relation(fields: [themeId], references: [id])
  mantas           EventManta[]
  participations   Participation[]
  stepsProgress    StepsProgress[]
  portfolioItems   PortfolioItem[]
  planning         Planning?
  observableStates TalentObservableState[]
  quizAttempts     TalentQuizAttempt[]
  cmsPages         CmsPage[]
  broadcasts       Broadcast[]
  minigameAttempts MinigameAttempt[]

  @@index([campusId])
}

model EventManta {
  eventId        String
  staffProfileId String

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@id([eventId, staffProfileId])
}

model Participation {
  id        String  @id @default(cuid())
  talentId  String
  eventId   String
  campusId  String
  isPresent Boolean @default(false)
  delay     Int?    @default(0)
  bringPc   Boolean @default(false)

  camperRating   Int?
  camperFeedback String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  talent          Talent                  @relation(fields: [talentId], references: [id], onDelete: Cascade)
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campus          Campus                  @relation(fields: [campusId], references: [id])
  activities      ParticipationActivity[]
  stageCompliance StageCompliance?
  interview       Interview?

  @@unique([talentId, eventId])
  @@index([eventId])
  @@index([campusId])
  @@index([talentId])
  @@index([talentId, campusId])
}

model StageCompliance {
  participationId   String   @id
  charteSigned      Boolean  @default(false)
  imageRightsSigned Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
}

model ParticipationActivity {
  participationId String
  activityId      String
  isPresent       Boolean                  @default(false)
  delay           Int                      @default(0)
  verdict         ParticipationVerdict?
  contextTag      ParticipationContextTag?
  verdictAuthorId String?
  verdictAt       DateTime?

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  activity      Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  verdictAuthor StaffProfile? @relation("VerdictAuthor", fields: [verdictAuthorId], references: [id])

  @@id([participationId, activityId])
  @@index([verdictAuthorId])
}

model Interview {
  id              String          @id @default(cuid())
  talentId        String
  staffId         String
  campusId        String
  participationId String?         @unique
  date            DateTime
  status          InterviewStatus @default(planned)

  discoveryReason   String?
  motivation        String?
  nextEventInterest String?
  platforms         String?
  specialties       String?
  interests         String?
  otherJobs         String?
  satisfaction      String?
  globalNote        String?
  recommendation    InterviewRecommendation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talent        Talent                @relation(fields: [talentId], references: [id], onDelete: Cascade)
  staff         StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  campus        Campus                @relation(fields: [campusId], references: [id], onDelete: Cascade)
  participation Participation?        @relation(fields: [participationId], references: [id], onDelete: SetNull)
  outlookSyncs  OutlookCalendarSync[]

  @@index([talentId])
  @@index([staffId])
  @@index([campusId])
}

/// One row per (Interview, user) pair we've pushed to that user's calendar.
/// Acts as the idempotency map across both sync backends:
///
///   - `syncKind = 'graph'`: `outlookEventId` is the Graph event id;
///     reconcile PATCH/DELETEs through Microsoft Graph using the user's
///     delegated `Calendars.ReadWrite` token. `sequence` and `contentHash`
///     are unused (Graph sends the latest body each time).
///   - `syncKind = 'email'`: `outlookEventId` is the iCalendar UID we
///     emit (stable: `<interview.id>@jump.epitech.eu`). `sequence` is
///     bumped on every meaningful change so Outlook merges the invite
///     update onto the existing event. `contentHash` lets us skip
///     re-sending an unchanged invite.
///
/// Per-user because each backend writes to the signed-in user's own
/// calendar — Graph via delegated token, email via the user's mailbox.
model OutlookCalendarSync {
  id             String   @id @default(cuid())
  interviewId    String
  userId         String
  outlookEventId String
  syncKind       String   @default("graph")
  sequence       Int      @default(0)
  contentHash    String?
  syncedAt       DateTime @updatedAt
  createdAt      DateTime @default(now())

  interview Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      bauth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([userId])
}

model StepsProgress {
  id               String        @id @default(cuid())
  talentId         String
  eventId          String
  activityId       String?
  currentStepId    String?
  unlockedStepId   String?
  status           StepStatus    @default(active)
  lastUnlockSource UnlockSource?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  talent   Talent    @relation(fields: [talentId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id])

  @@unique([talentId, activityId])
  @@index([eventId])
  @@index([talentId])
  @@index([activityId])
}

model PortfolioItem {
  id         String   @id @default(cuid())
  talentId   String
  eventId    String
  activityId String?
  file       String?
  url        String?
  caption    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  talent   Talent    @relation(fields: [talentId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id])

  @@index([talentId])
  @@index([eventId])
}

// ── Sync Error Logging ──

model SyncError {
  id              String    @id @default(cuid())
  errorType       String
  email           String
  attemptedExtId  String
  existingExtId   String?
  talentName      String
  eventExtId      String?
  message         String
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  occurrenceCount Int       @default(1)
  lastOccurredAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([email, attemptedExtId])
  @@index([resolved])
  @@index([lastOccurredAt])
}

// ── Planning Templates ──

model PlanningTemplate {
  id          String   @id @default(cuid())
  nom         String   @unique
  description String?
  nbDays      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days PlanningTemplateDay[]
}

model PlanningTemplateDay {
  id                 String   @id @default(cuid())
  planningTemplateId String
  dayIndex           Int
  label              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  planningTemplate PlanningTemplate       @relation(fields: [planningTemplateId], references: [id], onDelete: Cascade)
  slots            PlanningTemplateSlot[]

  @@unique([planningTemplateId, dayIndex])
  @@index([planningTemplateId])
}

model PlanningTemplateSlot {
  id                    String       @id @default(cuid())
  planningTemplateDayId String
  startTime             String
  endTime               String
  sortOrder             Int          @default(0)
  activityTemplateId    String?
  nom                   String?
  description           String?
  activityType          ActivityType @default(orga)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  day              PlanningTemplateDay @relation(fields: [planningTemplateDayId], references: [id], onDelete: Cascade)
  activityTemplate ActivityTemplate?   @relation(fields: [activityTemplateId], references: [id], onDelete: SetNull)

  @@index([planningTemplateDayId])
  @@index([activityTemplateId])
}

model CampusFeatureFlag {
  campusId  String
  flagKey   String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([campusId, flagKey])
  @@index([flagKey])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminFile {
  id           String   @id @default(cuid())
  name         String
  s3Key        String   @unique
  contentType  String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy StaffProfile @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
}

// ─── GitHub-backed Subjects + Competence Reference ───

model RefCompSnapshot {
  id        String   @id @default(cuid())
  commitSha String   @unique
  fetchedAt DateTime @default(now())
  isCurrent Boolean  @default(false)

  competences     Competence[]
  skills          Skill[]
  skillLevels     SkillLevel[]
  observables     Observable[]
  subjectVersions SubjectVersion[]

  @@index([isCurrent])
}

model Competence {
  id         String @id @default(cuid())
  snapshotId String
  domain     String
  desc       String

  snapshot RefCompSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  skills   Skill[]

  @@unique([snapshotId, domain])
}

model Skill {
  id           String @id @default(cuid())
  snapshotId   String
  competenceId String
  numericId    Int
  shortName    String

  snapshot   RefCompSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  competence Competence      @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  levels     SkillLevel[]

  @@unique([snapshotId, competenceId, numericId])
  @@index([snapshotId])
}

model SkillLevel {
  id         String @id @default(cuid())
  snapshotId String
  skillId    String
  level      String
  name       String
  desc       String

  snapshot           RefCompSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  skill              Skill                   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  subjectObservables SubjectObservable[]
  competenceStates   TalentCompetenceState[]

  @@unique([snapshotId, skillId, level])
  @@index([snapshotId])
}

model Observable {
  id          String @id @default(cuid())
  snapshotId  String
  projectSlug String
  externalId  Int
  desc        String

  snapshot           RefCompSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  subjectObservables SubjectObservable[]
  states             TalentObservableState[]

  @@unique([snapshotId, projectSlug, externalId])
  @@index([snapshotId])
  @@index([projectSlug])
}

model Subject {
  id      String @id @default(cuid())
  repoUrl String @unique
  slug    String @unique

  versions  SubjectVersion[]
  templates ActivityTemplate[]
}

model SubjectVersion {
  id                String   @id @default(cuid())
  subjectId         String
  repoCommitSha     String
  refCompSnapshotId String
  metadataJson      Json
  importedAt        DateTime @default(now())
  importedById      String

  subject         Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  refCompSnapshot RefCompSnapshot     @relation(fields: [refCompSnapshotId], references: [id])
  importedBy      StaffProfile        @relation(fields: [importedById], references: [id])
  documents       Document[]
  sections        Section[]
  quizzes         SubjectQuiz[]
  observableLinks SubjectObservable[]
  activities      Activity[]
  templates       ActivityTemplate[]

  @@unique([subjectId, repoCommitSha])
  @@index([subjectId])
  @@index([refCompSnapshotId])
}

model Document {
  id               String @id @default(cuid())
  subjectVersionId String
  path             String
  rawMd            String
  renderedHtml     String
  sortOrder        Int

  subjectVersion SubjectVersion @relation(fields: [subjectVersionId], references: [id], onDelete: Cascade)
  sections       Section[]
  quizzes        SubjectQuiz[]

  @@unique([subjectVersionId, path])
  @@index([subjectVersionId])
}

model Section {
  id               String  @id @default(cuid())
  subjectVersionId String
  documentId       String
  level            Int
  anchor           String
  title            String
  sortOrder        Int
  // For level=1 sections, the rendered HTML between this H1 and the next.
  // Computed at import time so the talent reader does no DOM-string surgery.
  // Null for H2/H3, which are tracked only for observable wiring.
  htmlSlice        String?

  subjectVersion        SubjectVersion          @relation(fields: [subjectVersionId], references: [id], onDelete: Cascade)
  document              Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  observableLinks       SubjectObservable[]
  observableStateSource TalentObservableState[] @relation("TalentObservableStateSourceSection")

  @@unique([subjectVersionId, documentId, anchor])
  @@index([subjectVersionId])
  @@index([documentId])
}

model SubjectObservable {
  id               String @id @default(cuid())
  subjectVersionId String
  sectionId        String
  observableId     String
  skillLevelId     String

  subjectVersion SubjectVersion @relation(fields: [subjectVersionId], references: [id], onDelete: Cascade)
  section        Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  observable     Observable     @relation(fields: [observableId], references: [id])
  skillLevel     SkillLevel     @relation(fields: [skillLevelId], references: [id])

  @@unique([sectionId, observableId])
  @@index([subjectVersionId])
  @@index([observableId])
  @@index([skillLevelId])
}

model SubjectQuiz {
  id               String @id @default(cuid())
  subjectVersionId String
  documentId       String
  fqn              String
  type             String
  expectedCount    Int?
  level            String
  externalIndex    Int
  title            String
  question         String
  options          Json
  canonicalAnswer  Json?

  subjectVersion SubjectVersion      @relation(fields: [subjectVersionId], references: [id], onDelete: Cascade)
  document       Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attempts       TalentQuizAttempt[]

  @@unique([subjectVersionId, fqn])
  @@index([subjectVersionId])
  @@index([documentId])
}

model TalentObservableState {
  id              String    @id @default(cuid())
  talentId        String
  eventId         String
  observableId    String
  // Section the talent had reached when this row was created. Lets the manta
  // validation view deep-link to the exact spot in the subject without
  // guessing among the SubjectObservable rows linked to the observable.
  sourceSectionId String?
  state           String
  observedById    String?
  observedAt      DateTime?
  createdAt       DateTime  @default(now())

  talent        Talent        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  observable    Observable    @relation(fields: [observableId], references: [id])
  observedBy    StaffProfile? @relation(fields: [observedById], references: [id])
  sourceSection Section?      @relation("TalentObservableStateSourceSection", fields: [sourceSectionId], references: [id], onDelete: SetNull)

  @@unique([talentId, eventId, observableId])
  @@index([talentId])
  @@index([eventId])
  @@index([observableId])
  @@index([state])
  @@index([sourceSectionId])
}

model TalentCompetenceState {
  id           String    @id @default(cuid())
  talentId     String
  skillLevelId String
  state        String
  certifiedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  talent     Talent     @relation(fields: [talentId], references: [id], onDelete: Cascade)
  skillLevel SkillLevel @relation(fields: [skillLevelId], references: [id])

  @@unique([talentId, skillLevelId])
  @@index([talentId])
  @@index([skillLevelId])
}

model TalentQuizAttempt {
  id          String   @id @default(cuid())
  talentId    String
  quizId      String
  eventId     String
  submitted   Json
  correct     Boolean
  attemptedAt DateTime @default(now())

  talent Talent      @relation(fields: [talentId], references: [id], onDelete: Cascade)
  quiz   SubjectQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([talentId])
  @@index([quizId])
  @@index([eventId])
}

model OnboardingReminder {
  id       String   @id @default(cuid())
  talentId String
  type     String // "student" | "parent"
  subject  String? // captured at send time, for audit + comm history
  body     String? // captured at send time, for audit + comm history
  sentAt   DateTime @default(now())
  sentBy   String // staff userId

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([talentId])
}

/// Tracking record for generating an onboarding PDF (charter/rules/image-rights)
/// and uploading it to S3. Created in the same transaction as the signature,
/// then generated in the background immediately after (see runOnboardingPdfJob)
/// so the signer isn't blocked. No auto-retry: a failed job stays in "error"
/// with the captured message, re-runnable from /staff/admin/onboarding-pdfs.
model OnboardingPdfJob {
  id           String    @id @default(cuid())
  talentId     String
  documentType String // "charter" | "rules" | "image-rights"
  status       String    @default("pending") // "pending" | "processing" | "success" | "error"
  filePath     String? // S3 key, set on success
  errorMessage String? // captured on failure
  payload      Json // snapshot of generator inputs (studentName, city, signedAt, etc.)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  processedAt  DateTime?

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([talentId])
}

// ── Tickets (staff → admin support) ──

model Ticket {
  id                 String    @id @default(cuid())
  authorId           String
  category           String // "bug" | "suggestion"
  title              String
  status             String    @default("open") // "open" | "closed"
  lastMessageAt      DateTime  @default(now())
  lastSeenByAuthorAt DateTime?
  lastSeenByAdminAt  DateTime?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  author   bauth_user      @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([authorId])
  @@index([status])
  @@index([lastMessageAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author bauth_user @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ─── Broadcasts (envoi en masse mail/SMS) ───

enum BroadcastChannel {
  mail
  sms
}

enum BroadcastStatus {
  queued
  sending
  sent
  partial_failed
  failed
}

enum BroadcastRecipientStatus {
  pending
  sent
  failed
}

enum BroadcastAudience {
  talent
  parent
  dev
  peda
  manta
  superdev
}

enum BroadcastSourceFilter {
  opened
  not_opened
  all
}

model MessageTemplate {
  id          String           @id @default(cuid())
  name        String
  channel     BroadcastChannel
  subject     String?
  body        String
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy           bauth_user           @relation("MessageTemplateCreator", fields: [createdById], references: [id])
  broadcasts          Broadcast[]
  emailActionMappings EmailActionMapping[]

  @@index([channel])
}

/// Maps a transactional email action (OTP login, welcome…) to a
/// MessageTemplate. Resolved at send time by `sendActionEmail`. When no
/// row exists for an action, the email is silently skipped (an admin
/// warning surfaces in `/staff/admin/email-actions`). Action keys live in
/// `$lib/domain/emailActions.ts`.
model EmailActionMapping {
  actionKey  String   @id
  templateId String
  updatedAt  DateTime @default(now()) @updatedAt

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Broadcast {
  id                String                 @id @default(cuid())
  name              String
  channel           BroadcastChannel
  templateId        String
  campusId          String
  audience          BroadcastAudience
  eventId           String?
  sourceBroadcastId String?
  sourceFilter      BroadcastSourceFilter?
  filters           Json?
  subjectSnapshot   String?
  bodySnapshot      String
  status            BroadcastStatus        @default(queued)
  createdById       String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  template        MessageTemplate      @relation(fields: [templateId], references: [id])
  campus          Campus               @relation(fields: [campusId], references: [id])
  event           Event?               @relation(fields: [eventId], references: [id])
  sourceBroadcast Broadcast?           @relation("BroadcastRetargeting", fields: [sourceBroadcastId], references: [id])
  retargets       Broadcast[]          @relation("BroadcastRetargeting")
  createdBy       bauth_user           @relation("BroadcastCreator", fields: [createdById], references: [id])
  recipients      BroadcastRecipient[]

  @@index([campusId])
  @@index([eventId])
  @@index([sourceBroadcastId])
  @@index([createdAt])
  @@index([status])
}

model BroadcastRecipient {
  id               String                   @id @default(cuid())
  broadcastId      String
  talentId         String?
  staffUserId      String?
  parentOfTalentId String?
  recipientEmail   String?
  recipientPhone   String?
  status           BroadcastRecipientStatus @default(pending)
  errorMessage     String?
  sentAt           DateTime?
  openedAt         DateTime?
  /// Number of send attempts so far. Capped by orchestrator's MAX_RETRIES.
  retryCount       Int                      @default(0)
  /// When the last send attempt happened. NULL = never tried. Used to gate
  /// retries: a transient failure can be retried after a backoff window.
  lastTriedAt      DateTime?
  createdAt        DateTime                 @default(now())

  broadcast Broadcast   @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  talent    Talent?     @relation("BroadcastRecipientTalent", fields: [talentId], references: [id], onDelete: SetNull)
  staffUser bauth_user? @relation("BroadcastRecipientStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  parentOf  Talent?     @relation("BroadcastRecipientParent", fields: [parentOfTalentId], references: [id], onDelete: SetNull)

  @@index([broadcastId])
  @@index([talentId])
  @@index([parentOfTalentId])
  @@index([staffUserId])
  @@index([openedAt])
  @@index([status])
}

// ─── Interests ───

model Interest {
  id    String  @id @default(cuid())
  nom   String  @unique
  emoji String?
  kind  String  @default("general") // "tech" | "general"
  order Int

  talentInterests TalentInterest[]
}

model TalentInterest {
  talentId   String
  interestId String

  talent   Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([talentId, interestId])
  @@index([interestId])
}

// ─── Minigames ───

enum MinigameScoring {
  score
  chrono
}

enum MinigameAttemptStatus {
  pending
  done
  invalid
}

// Host-side curation of the game catalogue: which games (by slug) are in the
// daily rotation and with what weight. Everything *about* a game — its display
// name, level count, scoring mode — is owned by jump-games and read live from
// its `GET /api/games` catalogue (src/lib/server/services/minigameCatalog.ts),
// never duplicated here. A game is in rotation iff it has a row with
// enabled = true; no row means "not curated yet" (off).
model MinigameConfig {
  game      String   @id // jump-games catalogue slug
  weight    Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A daily publication is an append-only fact: it records *what was published*.
// `gameName` and `scoringType` are snapshotted from the catalogue at publish
// time so historical leaderboards stay correct (and renderable) even if the
// game is later renamed or removed from jump-games. `game` is the slug, kept
// as a plain string (no FK) so a publication outlives any config/catalogue
// churn.
model MinigamePublication {
  id          String          @id @default(cuid())
  game        String
  gameName    String
  level       Int
  scoringType MinigameScoring
  publishedAt DateTime        @default(now())
  forcedById  String?

  attempts MinigameAttempt[]

  @@index([publishedAt])
  @@index([game])
}

model MinigameAttempt {
  id            String                @id @default(cuid())
  talentId      String
  publicationId String
  eventId       String?
  campusId      String?
  status        MinigameAttemptStatus @default(pending)
  score         Int?
  chrono        Int?
  valid         Boolean?
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?
  jti           String                @unique
  // XP granted for finishing this attempt (null = none, e.g. an invalid run or
  // a pre-feature row). Source of truth for the award — set once in the
  // callback, so a retried callback can't double-pay.
  xpAwarded     Int?
  // When the talent saw the "+XP" arrival celebration on the dashboard. Null
  // while xpAwarded is set ⇒ a fresh win still to be celebrated (mirrors
  // Talent.welcomeSeenAt). Gates the one-shot float so it can't replay.
  xpSeenAt      DateTime?

  talent      Talent              @relation(fields: [talentId], references: [id], onDelete: Cascade)
  publication MinigamePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  event       Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campus      Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([talentId, publicationId])
  @@index([eventId, publicationId])
  @@index([campusId, publicationId])
  @@index([publicationId])
}

// Append-only XP ledger. One row per granting fact, so a talent's balance is
// always explainable ("which event gave how much"). Talent.xp is a cached
// projection = SUM(amount), recomputed transactionally on every write — see
// services/xpService.ts. Grants are upserted on (source, sourceId) and deleted
// on reversal (unmark presence, remove participation, onboarding/dev reset), so
// there is never a clamped Math.max() refund to drift out of sync.
model XpGrant {
  id        String        @id @default(cuid())
  talentId  String
  campusId  String?
  source    XpGrantSource
  // Stable dedupe key per source: onboarding→talentId, minigame→attemptId,
  // activity_presence→participationId, admin_adjustment→null (never deduped:
  // Postgres treats NULLs as distinct under the unique index).
  sourceId  String?
  amount    Int
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  talent Talent  @relation(fields: [talentId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([talentId])
  @@index([campusId])
  @@index([source])
}

enum XpGrantSource {
  onboarding
  minigame
  activity_presence
  admin_adjustment
}
