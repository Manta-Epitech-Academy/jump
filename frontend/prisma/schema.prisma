// ─── Auth (BetterAuth managed) ───

model bauth_user {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions                  bauth_session[]
  accounts                  bauth_account[]
  staffProfile              StaffProfile?
  talent                    Talent?
  invitationsIssued         StaffInvitation[]    @relation("StaffInvitationInvitedBy")
  cmsPages                  CmsPage[]
  broadcastsCreated         Broadcast[]          @relation("BroadcastCreator")
  templatesCreated          MessageTemplate[]    @relation("MessageTemplateCreator")
  broadcastsReceivedAsStaff BroadcastRecipient[] @relation("BroadcastRecipientStaff")
  adminApiTokens            AdminApi_Token[]
}

model bauth_session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  impersonatedBy String?

  user bauth_user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Audit trail of impersonation sessions started by admins. Stores only user ids
/// (actor + target) so the facts survive account scrubs/deletions without
/// copying direct PII.
model Audit_ImpersonationEvent {
  id           String    @id @default(cuid())
  adminUserId  String
  targetUserId String
  targetKind   String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([adminUserId, startedAt])
  @@index([targetUserId])
}

model bauth_account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user bauth_user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model bauth_verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // NOT @unique: BetterAuth keeps multiple/overlapping verification rows per
  // identifier (e.g. concurrent OTP requests). A unique constraint made
  // `createVerificationOTP` (fastlogin path) 500 on a pre-existing row.
  @@index([identifier])
}

// ─── Domain Profiles ───

model StaffProfile {
  id                       String     @id @default(cuid())
  userId                   String     @unique
  campusId                 String?
  staffRole                StaffRole?
  // Personal dev-redirect destinations: on a trapped (non-prod) env, mail/SMS
  // attributed to this staff member (sends they trigger, or talents they
  // impersonate) is rerouted here instead of the shared `*_DEV_RECIPIENTS`
  // list, so each tester only receives their own traffic. Empty = fall back to
  // the env list. Inert in prod (the env gate is off). See
  // `$lib/server/{email,sms}/dev-redirect.ts`.
  devRedirectEmails        String[]   @default([])
  devRedirectPhones        String[]   @default([])
  // High-water mark for this admin's bulk onboarding-PDF archival: set each time
  // they download the full ("everything up to now") archive from
  // `/staff/admin/onboarding-pdfs`, so the page can surface the documents
  // finished since. A convenience filter, not a completeness guarantee (the
  // all-time export stays the authoritative archive); null = never exported.
  onboardingDocsExportedAt DateTime?
  // High-water mark for this admin's bulk interview-synthesis PDF archival, set
  // each time they download the full ("everything up to now") archive from
  // `/staff/admin/onboarding-pdfs`. Sibling of `onboardingDocsExportedAt`: a
  // convenience filter, not a completeness guarantee; null = never exported.
  interviewDocsExportedAt  DateTime?
  // High-water mark for this admin's Salesforce-divergences CSV export, set each
  // time they download the full ("everything up to now") CSV from
  // `/staff/admin/sf-conflicts`, so the menu can surface the talents confirmed
  // since. Same role as `onboardingDocsExportedAt`: a convenience filter, not a
  // completeness guarantee (the all-time export stays authoritative); null =
  // never exported.
  sfExportedAt             DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  user                   bauth_user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                 Campus?                     @relation(fields: [campusId], references: [id])
  interviewsConducted    Interview[]
  adminFiles             AdminFile[]
  cmsImages              CmsImage[]
  presencesMarked        EventPresence[]
  presenceClosuresMade   EventPresenceClosure[]
  imageRightsCorrections ImageRightsDecisionRecord[]
  interviewResets        InterviewReset[]            @relation("InterviewResetBy")
  notesAuthored          Note_TalentNote[]           @relation("Note_TalentNoteAuthor")
  notesEdited            Note_TalentNote[]           @relation("Note_TalentNoteEditor")
  feedbackFormsCreated   Feedback_Form[]             @relation("Feedback_FormCreator")
  feedbackFormsUpdated   Feedback_Form[]             @relation("Feedback_FormEditor")
  eventConfigTemplates   EventConfig_Template[]      @relation("EventConfigTemplateCreator")

  @@index([campusId])
}

model StaffInvitation {
  id              String    @id @default(cuid())
  email           String    @unique
  campusId        String?
  staffRole       StaffRole
  invitedByUserId String
  createdAt       DateTime  @default(now())

  campus    Campus?    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  invitedBy bauth_user @relation("StaffInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

model Talent {
  id                          String               @id @default(cuid())
  userId                      String?              @unique
  nom                         String
  prenom                      String
  niveau                      String?
  xp                          Int                  @default(0)
  eventsCount                 Int                  @default(0)
  charterAcceptedAt           DateTime?
  techInterestsValidatedAt    DateTime?
  generalInterestsValidatedAt DateTime?
  interestsRecapSeenAt        DateTime?
  rulesSignedAt               DateTime?
  imageRightsDecision         ImageRightsDecision?
  imageRightsDecidedAt        DateTime?
  // Guardian's typed legal name at the moment of the image-rights decision,
  // captured as prénom + nom to mirror the talent's own identity columns
  // (`prenom` / `nom`) — a single free-text field invited "first name only" /
  // "last name only" entries that read asymmetrically on the signed PDF.
  imageRightsSignerPrenom     String?
  imageRightsSignerNom        String?
  // Talent's place-of-signature, captured by the onboarding `signRules` form.
  // Lives on the row (not just in the PDF job payload) so the règlement PDF can
  // be regenerated from DB state alone when the guardian co-signs later.
  rulesSignedCity             String?
  // Which version of the règlement intérieur this signature committed to
  // (catalogue in `lib/content/reglement/`). The PDF is regenerated from DB
  // state on every co-signature, so without this the body would be re-rendered
  // from whatever the current text happens to be, under a signature already
  // given. Null means the signature predates the column: it resolves to the
  // legacy version, never to the current one.
  reglementVersion            String?
  // Guardian's online co-signature of the règlement intérieur. The talent signs
  // it during onboarding (`rulesSignedAt`); for a minor the legal guardian
  // co-signs it from the parent flow. The règlement PDF (`rulesFilePath`) is a
  // single shared artifact carrying both signature blocks; the worker
  // regenerates it from DB state every time either signer commits. Signer name
  // is split into prénom + nom for the same reason as image-rights above.
  parentRulesSignedAt         DateTime?
  parentRulesSignerPrenom     String?
  parentRulesSignerNom        String?
  parentRulesRelationship     String?
  parentRulesSignedCity       String?
  infoValidatedAt             DateTime?
  highSchoolValidatedAt       DateTime?
  parentsValidatedAt          DateTime?
  processingCompletedAt       DateTime?
  // Which school year the onboarding columns above describe. They are a cached
  // projection of the talent's most recent `Onboarding_Record`, so on their own
  // they cannot say whether the dossier is this year's or last year's. A reader
  // asking "is the dossier for year Y done" compares this; a reader asking "did
  // they ever sign" ignores it (see `domain/talentOnboarding.ts`).
  onboardingSchoolYear        String?
  schoolId                    String?
  // Free-text fallback used only when the talent's lycée has no UAI (so no
  // canonical `School` row exists). When `schoolId` is set this stays null.
  highSchoolNameManual        String?
  rulesFilePath               String?
  imageRightsFilePath         String?
  parentEmail                 String?
  parentNom                   String?
  parentPrenom                String?
  parentPhone                 String?
  phone                       String?
  civilite                    String?
  parentType                  String?
  parentCivilite              String?
  parent2Type                 String?
  parent2Civilite             String?
  parent2Nom                  String?
  parent2Prenom               String?
  parent2Email                String?
  parent2Phone                String?
  /// RETIRED, dropped in a follow-up migration. No code reads or writes it:
  /// the laptop requirement is certified on the règlement step, where the
  /// clause it certifies is actually written down. Kept one release so a
  /// rolling deploy does not break pods still running the previous build.
  hasLaptop                   Boolean              @default(false)
  setupDescription            String?
  equipmentValidatedAt        DateTime?
  interestsFreeText           String?
  externalId                  String?              @unique
  lastActiveAt                DateTime?
  // First real (non-impersonated) login, stamped once in hooks.server.ts and
  // never cleared. A durable projection of "has this talent ever connected" —
  // distinct from probing bauth_session, whose rows are deleted by logout,
  // identity repair and account relinks, so a real login would otherwise read
  // "Jamais" once its session row is gone. Paired with lastActiveAt (MAX
  // activity); this is the MIN.
  firstLoginAt                DateTime?
  welcomeSeenAt               DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  user                bauth_user?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  participations      Participation[]
  interviews          Interview[]
  pdfJobs             OnboardingPdfJob[]
  minigameAttempts    MinigameAttempt[]
  interests           TalentInterest[]
  xpGrants            XpGrant[]
  school              School?                     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sfImport            TalentSfImport?
  broadcastsReceived  BroadcastRecipient[]        @relation("BroadcastRecipientTalent")
  broadcastsAsParent  BroadcastRecipient[]        @relation("BroadcastRecipientParent")
  deletionRequests    TalentDeletionRequest[]
  eventPresences      EventPresence[]
  imageRightsRecords  ImageRightsDecisionRecord[]
  feedbackSubmissions Feedback_Submission[]
  interviewResets     InterviewReset[]
  schoolingRecords    Schooling_YearRecord[]
  onboardingRecords   Onboarding_Record[]
  notes               Note_TalentNote[]

  @@index([xp])
  @@index([schoolId])
}

/// Canonical high-school directory, keyed by the national UAI (RNE) code.
/// Rows are created lazily the first time a UAI is seen — Salesforce sync or a
/// talent picking from the annuaire — then enriched from the official
/// éducation-nationale annuaire. Only schools actually attended by a talent ever
/// land here, never the full ~69k national dataset.
model School {
  id         String    @id @default(cuid())
  uai        String    @unique
  name       String
  city       String?
  postalCode String?
  inseeCode  String?
  /// null = created from a fallback name (annuaire lookup pending or failed); a
  /// backfill pass fills name/city/codes once the annuaire resolves the UAI.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  talents          Talent[]
  sfClaimedBy      TalentSfImport[]
  schoolingRecords Schooling_YearRecord[]
}

/// Per-school-year record of a student's class level and school attendance.
/// Stores per-year facts for each school year cycle (opening July 31). `Talent.niveau`
/// and `Talent.schoolId` are cached projections of the current school year's record,
/// updated transactionally via schoolingService.
model Schooling_YearRecord {
  id         String   @id @default(cuid())
  talentId   String
  talent     Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  schoolYear String // e.g. "2026-2027", canonical format from domain/schoolYear.ts
  niveau     String? // catalogue in domain/niveau.ts
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  source     String // vocabulary in code as `SchoolingSource` (schoolingService)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([talentId, schoolYear])
  @@index([schoolYear, schoolId])
  @@index([schoolYear, niveau])
}

/// Per-school-year onboarding dossier: the platform sign-up a talent walks once
/// per year. Same shape as `Schooling_YearRecord` above - the row is the fact,
/// and the flat onboarding columns on `Talent` are a cached projection of the
/// most recent one, refreshed transactionally by `onboardingYearService` and
/// stamped with `Talent.onboardingSchoolYear` so a reader can tell which year
/// the projection describes.
///
/// A new year's dossier starts blank on purpose: nothing is carried forward from
/// the previous one, which is what makes a returning talent re-walk the ladder
/// and re-sign the current règlement. The profile they filled in (name, phone,
/// parents, setup) stays on `Talent` and pre-fills the form.
///
/// Deliberately NOT here, each for its own reason:
///   - `Talent.welcomeSeenAt` - the first-arrival splash, shown once per account,
///     not once per year.
///   - `Talent.charterAcceptedAt` - the RGPD charte is a data-processing consent,
///     not a yearly contract, and it is owed even to a talent who never walks the
///     ladder (hence the standalone `/charte`). Filing it per year would also make
///     it a yearly gate for collégiens, who have no dossier at all.
///   - `Talent.rulesFilePath` - a render, not a fact. `rulesSignedAt` +
///     `rulesSignedCity` + `reglementVersion` freeze the signature, and the
///     règlement text is version-pinned, so any year's PDF is reproducible from
///     this row. The bucket only ever holds the current artifact.
///   - `Talent.setupDescription` - current truth about the student's kit, read by
///     the staff fiche like `phone` or `nom`. Only its gate is per-year.
model Onboarding_Record {
  id         String @id @default(cuid())
  talentId   String
  talent     Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)
  schoolYear String // e.g. "2026-2027", canonical format from domain/schoolYear.ts

  // The ladder gates, in ONBOARDING_STEP_ORDER (domain/talentOnboarding.ts).
  // `interestsRecapSeenAt` is not a gate but is written and rewound with the
  // interests step, so it belongs to the same dossier.
  infoValidatedAt             DateTime?
  highSchoolValidatedAt       DateTime?
  parentsValidatedAt          DateTime?
  techInterestsValidatedAt    DateTime?
  generalInterestsValidatedAt DateTime?
  interestsRecapSeenAt        DateTime?
  equipmentValidatedAt        DateTime?
  processingCompletedAt       DateTime?
  rulesSignedAt               DateTime?

  // What freezes this year's règlement signatures - the talent's and, for a
  // minor, the legal guardian's co-signature of the same document.
  rulesSignedCity         String?
  reglementVersion        String?
  parentRulesSignedAt     DateTime?
  parentRulesSignerPrenom String?
  parentRulesSignerNom    String?
  parentRulesRelationship String?
  parentRulesSignedCity   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talentId, schoolYear])
}

/// 1:1 mirror of what Salesforce last claimed for a talent — the anti-corruption
/// boundary. Upserted by the worker sync (only when the inbound payload differs),
/// never written by onboarding. Reconciliation compares this against the `Talent`
/// row: a divergence on a talent-confirmed field is a conflict. School is compared
/// by FK (`sfSchoolId` vs `Talent.schoolId`), scalars value-by-value. `niveau` is
/// kept for a faithful snapshot but is SF-owned, never reconciled.
model TalentSfImport {
  talentId   String   @id
  nom        String?
  prenom     String?
  // SF's claimed login email. SF-owned (never talent-editable), so it is the
  // "desired" login identity the sync drives `bauth_user.email` toward via
  // `changeUserEmail`. Not a reconciled field (like `niveau`): a divergence from
  // `bauth_user.email` is an auth-identity conflict, surfaced in the AUTH tab.
  sfEmail    String?
  phone      String?
  civilite   String?
  niveau     String?
  sfSchoolId String?
  syncedAt   DateTime @updatedAt

  talent   Talent  @relation(fields: [talentId], references: [id], onDelete: Cascade)
  sfSchool School? @relation(fields: [sfSchoolId], references: [id], onDelete: SetNull)

  @@index([sfSchoolId])
}

// RGPD erasure as a fact log, not an instant destructive action. A talent's
// "delete my account" no longer wipes rows on the spot — it appends a pending
// request here. Staff fulfil it (→ anonymisation, the real erasure mechanism)
// or reject it; the talent can withdraw their own pending request. Each
// transition is a status on the same row, so the request doubles as the audit
// trail of *when* and *by whom* an account was erased. See xpService for the
// same facts-as-rows shape.
enum TalentDeletionRequestStatus {
  pending
  fulfilled
  rejected
  cancelled
}

/// The legal guardian's image-rights decision for their child. `null` on Talent
/// means undecided (still to be chased); a non-null value is a settled decision
/// — `refused` is as final as `accepted`, it just means "do not photograph".
enum ImageRightsDecision {
  accepted
  refused
}

/// Where an image-rights decision was recorded from.
enum ImageRightsDecisionSource {
  /// The legal guardian, via the parent flow or the child dashboard.
  parent_portal
  /// Staff, recording a guardian's offline change of mind on their behalf
  /// (a phone call or email). Carries `recordedByStaffId` + a `note` for audit.
  staff_correction
}

/// Append-only fact log of image-rights decisions — one row per choice or
/// revision, never overwritten. The current value cached on
/// `Talent.imageRights*` is a projection of the latest row here (same shape as
/// the XP ledger: facts as rows, state as projection; see CLAUDE.md "Data
/// modeling"). A guardian revoking "à tout moment" or staff correcting an
/// offline change of mind both append a new row, so the full history of who
/// decided what and when survives — which matters legally for a minor's consent.
///
/// `relationship` and `city` are persisted here (they previously lived only in
/// the transient PDF job payload, so they were unqueryable after generation).
model ImageRightsDecisionRecord {
  id                String                    @id @default(cuid())
  talentId          String
  decision          ImageRightsDecision
  /// When the guardian made this choice (the signature timestamp).
  decidedAt         DateTime
  /// Signer identity + context. Nullable only because rows backfilled from the
  /// pre-ledger projection carry just what `Talent` persisted (signer name, if
  /// any; relationship/city were never stored). Every row written going forward
  /// fills all four — the parent and staff forms require them.
  signerPrenom      String?
  signerNom         String?
  relationship      String?
  city              String?
  source            ImageRightsDecisionSource @default(parent_portal)
  /// The staff member who recorded a `staff_correction`; null for `parent_portal`.
  recordedByStaffId String?
  /// Staff reason for the correction (why the decision was changed offline).
  note              String?
  createdAt         DateTime                  @default(now())

  talent     Talent        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  recordedBy StaffProfile? @relation(fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  @@index([talentId, createdAt])
}

model TalentDeletionRequest {
  id             String                      @id @default(cuid())
  talentId       String
  status         TalentDeletionRequestStatus @default(pending)
  // Optional free-text the talent leaves when asking ("I'm leaving school"…).
  reason         String?
  requestedAt    DateTime                    @default(now())
  // Set on any terminal transition (fulfilled / rejected / cancelled).
  resolvedAt     DateTime?
  // bauth_user.id of the admin who fulfilled/rejected; null for self-withdrawal.
  resolvedBy     String?
  // Staff note on a rejection. Shown to the talent as the official reason
  // (RGPD art. 12(4): the data subject must be told why erasure was declined),
  // so it's written for them, not as an internal shorthand.
  resolutionNote String?
  // When the talent dismissed the rejection notice in their settings. Until
  // set, the notice keeps showing; re-requesting (a new row) also clears it.
  acknowledgedAt DateTime?

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([talentId])
}

/// One staff note about a talent. Replaces the single free-text `Talent.note`
/// column with a 1:N feed: many notes per talent, each authored and timestamped
/// (created + last-edited). Mutable in place — editing fixes the document, hence
/// `updatedAt`, NOT an append-only ledger (nothing aggregates from it, so the
/// facts-as-rows shape — XpGrant, ImageRightsDecisionRecord — would be over-built
/// here). Any dev member can edit/delete any note (small internal team; the
/// predecessor was a single shared note anyone could overwrite). Staff-only;
/// NEVER loaded in a talent request. Optional `eventId` anchors the screen the
/// note was taken on (émargement prefills it); null for a general fiche note.
model Note_TalentNote {
  id           String        @id @default(cuid())
  talentId     String
  // Author + last editor as FKs (rendered "écrit par / modifié par" in the feed).
  // SetNull so a staff departure never deletes a talent's note history.
  authorId     String?
  editedById   String?
  body         String
  // Optional origin anchor. SetNull: deleting the event drops the context, the
  // note about the talent survives.
  eventId      String?
  // The émargement créneau the note was taken on, when created from the émargement
  // dialog (else null, e.g. a general note from the fiche). Stored as a fact rather
  // than inferred from `createdAt`: it's what makes the roster trigger and the
  // "Ce créneau" group exact instead of "typed during this half-day". Mirrors
  // EventPresence's (day, slot) shape; only meaningful alongside `eventId`.
  presenceDay  DateTime?     @db.Date
  presenceSlot PresenceSlot?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  talent   Talent        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  author   StaffProfile? @relation("Note_TalentNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editedBy StaffProfile? @relation("Note_TalentNoteEditor", fields: [editedById], references: [id], onDelete: SetNull)
  event    Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([talentId, createdAt])
  @@index([eventId])
}

// ─── Domain Tables ───

model Campus {
  id           String   @id @default(cuid())
  name         String   @unique
  externalName String?  @unique
  timezone     String   @default("Europe/Paris")
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfiles    StaffProfile[]
  events           Event[]
  participations   Participation[]
  interviews       Interview[]
  invitations      StaffInvitation[]
  broadcasts       Broadcast[]
  minigameAttempts MinigameAttempt[]
  xpGrants         XpGrant[]
  xpRewards        XpReward[]
  signatories      Signatory[]
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String
  eventId   String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  bauth_user @relation(fields: [updatedBy], references: [id])

  @@unique([slug, eventId])
  @@index([eventId])
}

model Planning {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]
}

model TimeSlot {
  id         String   @id @default(cuid())
  planningId String
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  planning Planning  @relation(fields: [planningId], references: [id], onDelete: Cascade)
  activity Activity?

  @@index([planningId])
}

model Activity {
  id           String       @id @default(cuid())
  nom          String
  activityType ActivityType
  timeSlotId   String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
}

model Event {
  id             String    @id @default(cuid())
  titre          String
  // Salesforce campaign name (`titre`) is an internal identifier, ugly to show
  // ("Montpellier-19-06-2026-CodingClub"). `publicName` is the friendly name an
  // admin types, surfaced in the dev switcher / talent widget / page chrome in
  // its place. `null` falls back to `titre` everywhere (see `eventDisplayName`).
  // Admin-set today; the worker may seed it from SF later (plain nullable field
  // so a future no-clobber sync can write it, like the other reconciled fields).
  publicName     String?
  // What one member of this event's cohort is called across the dev workspace
  // ("stagiaire", "participant", "collégien", ...). Jump-owned free text typed in
  // the event config wizard and read straight off this column; nothing infers it
  // from what kind of event it is. A per-format default rides the config template
  // staff start from. NULL means "not named yet" (an unconfigured event): the UI
  // falls back to the neutral default ("participant") via `cohortNounForms`, so
  // the column never asserts an unmade choice. Past stages were backfilled to
  // "stagiaire" (a real historical value).
  cohortNoun     String?
  date           DateTime
  // Salesforce gives us the calendar day (`date`/`endDate`) but never a
  // start time, so the time-of-day is Jump-owned: wall-clock minutes from
  // local midnight (0–1439), `null` until staff set it. Kept separate from
  // `date` precisely so the SF sync — which rewrites `date` — can never
  // clobber it. Compose with the campus timezone for a real instant.
  startMinutes   Int?
  endDate        DateTime?
  campusId       String
  // Which feedback form this event uses (the `bilan` module reports against it,
  // and its QR/link/export resolve through it). Null = no feedback form on this
  // event (the bilan surface stays hidden). SetNull so deleting a form just drops
  // the binding rather than the event.
  feedbackFormId String?
  externalId     String?   @unique
  // Explicit admin gate for the dev workspace, decoupled from modules: an event
  // appears in the dev sidebar/switcher only once an admin activates it here.
  // `null` = not yet validated (hidden, even when its modules are pre-configured).
  // Modules decide WHICH surfaces show; this decides WHETHER the event shows at
  // all. Set on activate, cleared on deactivate.
  devActivatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campus              Campus                 @relation(fields: [campusId], references: [id])
  feedbackForm        Feedback_Form?         @relation("EventFeedbackForm", fields: [feedbackFormId], references: [id], onDelete: SetNull)
  participations      Participation[]
  planning            Planning?
  cmsPages            CmsPage[]
  broadcasts          Broadcast[]
  minigameAttempts    MinigameAttempt[]
  presenceClosures    EventPresenceClosure[]
  eventPresences      EventPresence[]
  feedbackSubmissions Feedback_Submission[]
  talentNotes         Note_TalentNote[]
  modules             EventConfig_Module[]

  @@index([campusId])
  @@index([feedbackFormId])
}

// Per-event surface configuration for the dev workspace. A row's mere
// presence = that module is enabled for the event (no `enabled` boolean: the
// event's rows ARE the truth, there is no campus-wide default to override).
// `moduleKey` is validated in code against
// EVENT_MODULES (a plain string so a new module needs no migration). Seeded with
// every module on at creation; the SF sync never touches these rows, so the
// per-event config is never clobbered. See src/lib/domain/eventModules.ts.
model EventConfig_Module {
  eventId   String
  moduleKey String
  // Per-module sub-options (e.g. inscrits.showStatutColumn). Null = module-default
  // settings. They are heterogeneous per module and meant to grow, so a Json bag
  // validated app-side (per-module Zod in domain/eventModules.ts) beats a sparse
  // wide table; FKs (like feedbackFormId) stay typed columns on Event, never here.
  settings  Json?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, moduleKey])
  @@index([moduleKey])
}

// A reusable, named event-configuration preset (global), created by staff from
// the config wizard ("Enregistrer comme modèle"). Applying
// one is a point-in-time SEED: the wizard copies its modules + settings + default
// feedback form into the event, with no live link afterwards (the event's own
// rows stay the truth). `name` is globally unique → saving with an existing
// name updates that template (upsert), which is how a template is edited.
model EventConfig_Template {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  // The friendly event name the preset carries (e.g. "Coding Club"). Captured
  // because campuses reuse one display name across every occurrence of a format
  // (Strasbourg has "Coding Club" ×10), so a preset that doesn't pre-fill it just
  // makes the admin retype the same string. Like the live `Event.publicName`,
  // applying it is a point-in-time copy; `null` = the event keeps the SF `titre`.
  publicName     String?
  // Cohort noun the preset carries ("stagiaire", ...), copied onto the event on
  // apply like the other config fields. Mirrors `Event.cohortNoun`; `null` = the
  // preset names no cohort (the applied event falls back to the neutral default).
  cohortNoun     String?
  // Jump-owned arrival time-of-day the preset carries, in wall-clock minutes from
  // local midnight (0-1439), `null` = none (the event falls back to the single
  // default). Mirrors `Event.startMinutes`; copied onto the event on apply.
  startMinutes   Int?
  feedbackFormId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feedbackForm Feedback_Form?               @relation("EventConfigTemplateFeedbackForm", fields: [feedbackFormId], references: [id], onDelete: SetNull)
  createdBy    StaffProfile?                @relation("EventConfigTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules      EventConfig_TemplateModule[]

  @@index([feedbackFormId])
}

// Mirror of EventConfig_Module on the template side (presence = enabled, same
// `settings` Json shape), so applying a template or saving one is a plain row copy.
model EventConfig_TemplateModule {
  templateId String
  moduleKey  String
  settings   Json?

  template EventConfig_Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, moduleKey])
}

model Participation {
  id             String  @id @default(cuid())
  talentId       String
  eventId        String
  campusId       String
  /// RETIRED, dropped in a follow-up migration. Nothing has ever read it: the
  /// only writes were a reset-to-defaults and the seed. Kept one release for
  /// the rolling deploy, same as `Talent.hasLaptop`.
  bringPc        Boolean @default(false)
  sfMemberStatus String? // raw Salesforce CampaignMember status, e.g. CONNECTED/READY/MEET/DESISTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talent          Talent           @relation(fields: [talentId], references: [id], onDelete: Cascade)
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campus          Campus           @relation(fields: [campusId], references: [id])
  stageCompliance StageCompliance?
  interview       Interview?

  @@unique([talentId, eventId])
  @@index([eventId])
  @@index([eventId, sfMemberStatus])
  @@index([campusId])
  @@index([talentId])
  @@index([talentId, campusId])
}

/// RETIRED, dropped in a follow-up migration along with its `Participation`
/// back-relation. `charteSigned` was a staff attestation of an offline
/// règlement signature, and no code path could ever set it, so in production it
/// was always false. With one generic règlement signed once, an attestation
/// scoped to a single participation makes no sense either: if the offline path
/// is wanted again it belongs to the talent or to their yearly dossier. Kept
/// one release so a rolling deploy does not break the previous build.
model StageCompliance {
  participationId String   @id
  charteSigned    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
}

// Administrative attendance ("émargement"), one record per half-day a talent is
// expected at an event. Deliberately autonomous: it keys on (talentId, eventId)
// directly, NOT on Participation, because participations / event-presence are
// owned by Salesforce (campaign member status) and the SF sync rewrites
// Participation. This table is the staff's own operational appel, decoupled from
// that lifecycle, with the XLSX export as its only deliverable (no SF write-back).
// A missing row = "en attente" (not handled yet), so the table stays sparse and
// closing a slot just inserts the absent rows. Scoped via event.campusId, like
// Planning. The enrollment roster is still READ from Participation (the SF
// mirror) to know who to list; only the storage is decoupled.
model EventPresence {
  id         String         @id @default(cuid())
  talentId   String
  eventId    String
  day        DateTime       @db.Date
  slot       PresenceSlot
  status     PresenceStatus
  source     PresenceSource @default(manual)
  markedById String?
  markedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  talent   Talent        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  markedBy StaffProfile? @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([talentId, eventId, day, slot])
  @@index([eventId, day, slot])
  @@index([markedById])
}

// Marks a half-day's émargement as closed: late self-check-in is refused and
// every still-pending talent has been turned absent. A missing row = the slot
// is open. Event-wide (not per-talent), so it hangs off Event and is scoped via
// event.campusId, like Planning.
model EventPresenceClosure {
  id         String       @id @default(cuid())
  eventId    String
  day        DateTime     @db.Date
  slot       PresenceSlot
  closedById String?
  closedAt   DateTime     @default(now())

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  closedBy StaffProfile? @relation(fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([eventId, day, slot])
}

// ─── Feedback ("Bilan du stage") ───
// Normalized, runtime-editable feedback forms. Definition tree:
//   Feedback_Form -> Feedback_Section -> Feedback_Question -> Feedback_QuestionOption
// Response tree:
//   Feedback_Submission -> Feedback_Answer -> Feedback_AnswerOption
// Stats are a groupBy on optionId (rename-safe). The Restrict FKs on
// Feedback_Answer.question and Feedback_AnswerOption.option enforce the
// structural-edit lock at the DB: once a form has responses, questions/options
// it depends on can't be deleted, so the admin must duplicate to restructure.

enum Feedback_FormStatus {
  draft
  published
  archived
}

enum Feedback_QuestionType {
  single
  multiple
  scale
  text
  textarea
}

enum Feedback_InputKind {
  email
  tel
  name
  text
}

enum Feedback_OptionKind {
  choice
  extra
}

// Marks a question as collecting one piece of respondent identity, and which
// typed Feedback_Submission.respondent* column it routes into. Replaces the old
// `identity` boolean + magic-key prefill: identity questions are shown only to
// public respondents (connected talents are read from Talent) and are always
// required. Null = a normal content question.
enum Feedback_IdentityField {
  email
  phone
  firstName
  lastName
  civility
  campus
}

enum Feedback_SubmissionSource {
  authenticated
  public
}

model Feedback_Form {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  // Opening bot line (interpolated, e.g. "Salut {prenom} !"). Null = the
  // engine's default greeting, mirroring `outro` below.
  intro          String?
  personaName    String?
  // S3 object key of the uploaded persona avatar (WebP). Null = the default
  // mascot art. Served through the public /api/feedback-forms/[id]/persona-icon
  // proxy; the key changes on every replace so the rendered ?v= URL busts cache.
  personaIconKey String?
  status         Feedback_FormStatus @default(draft)

  allowsAuthenticatedAccess Boolean @default(true)
  allowsPublicAccess        Boolean @default(false)
  // The form(s) the talent dashboard nudges past the feedback deadline. Replaces
  // the old hardcoded STAGE_FORM_ID coupling.
  dashboardNudge            Boolean @default(false)

  // Closing bot line emitted once the conversation ends (interpolated, e.g.
  // "Merci {prenom} !"). Null = the engine's generic fallback.
  outro String?

  // Author + last editor (rendered in the admin builder). SetNull so a staff
  // departure never deletes a form.
  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       StaffProfile?          @relation("Feedback_FormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       StaffProfile?          @relation("Feedback_FormEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  sections        Feedback_Section[]
  questions       Feedback_Question[]
  submissions     Feedback_Submission[]
  events          Event[]                @relation("EventFeedbackForm")
  configTemplates EventConfig_Template[] @relation("EventConfigTemplateFeedbackForm")

  @@index([status])
}

model Feedback_Section {
  id       String  @id @default(cuid())
  formId   String
  position Int
  title    String
  // Stored once per section (not repeated on each question) -> 3NF.
  intro    String?

  form      Feedback_Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  questions Feedback_Question[]

  @@index([formId, position])
}

model Feedback_Question {
  id        String  @id @default(cuid())
  formId    String
  // Null for questions outside any section.
  sectionId String?
  // Stable semantic answer key (e.g. "campus", "avis_accueil"), unique per form.
  key       String
  position  Int

  prompt        String
  type          Feedback_QuestionType
  required      Boolean                 @default(true)
  // When set, this question collects one piece of respondent identity and routes
  // into the matching Feedback_Submission.respondent* column. Shown only on the
  // public form (connected talents are read from Talent), never produces a
  // Feedback_Answer row, and is always treated as required. Null = content question.
  identityField Feedback_IdentityField?
  inputKind     Feedback_InputKind?
  minSelections Int?
  maxSelections Int?
  placeholder   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form    Feedback_Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  section Feedback_Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options Feedback_QuestionOption[]
  answers Feedback_Answer[]

  @@unique([formId, key])
  @@index([formId, position])
  @@index([sectionId])
}

model Feedback_QuestionOption {
  id         String              @id @default(cuid())
  questionId String
  position   Int
  // Shown text + canonical stored value. Answers reference this row's id, never
  // its label, so renaming the label never orphans a response.
  label      String
  kind       Feedback_OptionKind @default(choice)
  // Optional bot reaction emitted (interpolated) right after this option is
  // picked, before the next question. Null = no reaction. Pure conversational
  // copy: never persisted as an answer, never affects routing or stats.
  reaction   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question      Feedback_Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerOptions Feedback_AnswerOption[]

  @@index([questionId, position])
}

model Feedback_Submission {
  id     String                    @id @default(cuid())
  formId String
  source Feedback_SubmissionSource

  // Set for authenticated submissions; null for public until reconciled.
  talentId  String?
  // The cohort event (authenticated). Null for public: a non-onboarded campus has
  // no Jump event.
  eventId   String?
  // When a public submission was later linked to a Talent by email.
  matchedAt DateTime?

  // Self-reported respondent identity. Populated ONLY for public submissions; for
  // authenticated ones identity is read from the linked Talent (single source).
  respondentEmail       String?
  respondentFirstName   String?
  respondentLastName    String?
  respondentPhone       String?
  respondentCivility    String?
  respondentCampusLabel String?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  form    Feedback_Form     @relation(fields: [formId], references: [id], onDelete: Restrict)
  talent  Talent?           @relation(fields: [talentId], references: [id], onDelete: SetNull)
  event   Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  answers Feedback_Answer[]

  // Non-null for authenticated -> one submission per talent per event per form.
  // Both null for public -> Postgres treats NULLs as distinct, so public rows never collide.
  @@unique([formId, eventId, talentId])
  @@index([eventId])
  @@index([formId, source])
  @@index([talentId])
  @@index([respondentEmail])
}

model Feedback_Answer {
  id           String  @id @default(cuid())
  submissionId String
  questionId   String
  // For text / textarea answers.
  freeText     String?

  submission      Feedback_Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  // Restrict: enforces the structural-edit lock (a question with answers can't be deleted).
  question        Feedback_Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptions Feedback_AnswerOption[]

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model Feedback_AnswerOption {
  answerId String
  optionId String

  answer Feedback_Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  // Restrict: an option with answers can't be deleted (structural-edit lock).
  option Feedback_QuestionOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@index([optionId])
}

enum PresenceSlot {
  morning
  afternoon
}

enum PresenceStatus {
  present
  late
  absent
  excused
}

enum PresenceSource {
  qr
  manual
  system
}

/// One stage-de-seconde orientation interview, 1:1 with the talent's
/// participation in that stage. The questionnaire answers live inline:
/// single-choice as enum columns, multi-choice as Postgres enum arrays,
/// plus a 1–5 satisfaction rating and a few free-text fields. Conducted by
/// the dev (Talent Acquisition) team from the talent fiche; no row exists
/// until staff opens the grid (absence = "à faire").
model Interview {
  id              String          @id @default(cuid())
  talentId        String
  staffId         String
  campusId        String
  participationId String          @unique
  status          InterviewStatus @default(in_progress)
  conductedAt     DateTime        @default(now())

  // Single-choice answers (null until answered).
  discoveryChannel        DiscoveryChannel?
  motivation              InterviewMotivation?
  orientationTalkAtSchool OrientationTalkFrequency?
  passionateTeacher       PassionateTeacherAnswer?
  wantsMore               WantsMoreAnswer?
  recommendation          InterviewRecommendation?

  // Multi-choice answers (Postgres enum arrays).
  techProjection TechProjection[] @default([])
  specialties    Specialty[]      @default([])
  otherJobs      OtherJobDomain[] @default([])
  infoSources    InfoSource[]     @default([])
  nextYearEvents NextYearEvent[]  @default([])

  // Scalars / free text.
  satisfactionStars Int?
  oneSentence       String?
  verdictNote       String?

  // Per-question free-text note, one per choice/rating question. Always offered
  // under the question (no longer gated by an "Autre" choice), so the dev can jot
  // anything the chips don't capture. See domain/interview.ts (NOTE_FIELDS).
  discoveryChannelNote  String?
  motivationNote        String?
  specialtiesNote       String?
  orientationTalkNote   String?
  passionateTeacherNote String?
  techProjectionNote    String?
  otherJobsNote         String?
  infoSourcesNote       String?
  wantsMoreNote         String?
  satisfactionNote      String?
  nextYearEventsNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talent        Talent        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  staff         StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  campus        Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([talentId])
  @@index([staffId])
  @@index([campusId])
}

/// Audit trail for an orientation interview an admin reset. An interview
/// finalized by mistake is hard-deleted, so the talent returns to "à faire" and
/// a fresh interview can be conducted; this append-only row is the only trace
/// left of the discarded one: whose it was, who had conducted it, when, who
/// reset it and why. A destructive reversal of a colleague's finalized work on a
/// minor's record never happens silently. Pure accountability, never read on a
/// hot path.
model InterviewReset {
  id                 String   @id @default(cuid())
  talentId           String
  /// Snapshot of the deleted interview (its row no longer exists, so these are
  /// plain fields, not relations): who conducted it and when.
  conductedByStaffId String?
  conductedAt        DateTime
  /// The admin who performed the reset; kept as a live FK for "reset by" lookups.
  resetByStaffId     String?
  /// Why it was reset. Required, collected in the confirm dialog.
  reason             String
  createdAt          DateTime @default(now())

  talent  Talent        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  resetBy StaffProfile? @relation("InterviewResetBy", fields: [resetByStaffId], references: [id], onDelete: SetNull)

  @@index([talentId, createdAt])
}

// ── Sync Error Logging ──

model SyncError {
  id              String    @id @default(cuid())
  errorType       String
  email           String
  attemptedExtId  String
  existingExtId   String?
  talentName      String
  eventExtId      String?
  message         String
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  occurrenceCount Int       @default(1)
  lastOccurredAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([email, attemptedExtId])
  @@index([resolved])
  @@index([lastOccurredAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A signatory whose handwritten signature is printed on the internship
// certificate (diplôme de stage). `campusId` null = global (e.g. the Director
// General) and applies to every campus without duplication; a set `campusId`
// scopes the signatory to one campus's local managers. The signature image
// bytes live in S3 under `signatureKey`; `position` orders the blocks on the
// diploma.
model Signatory {
  id           String   @id @default(cuid())
  campusId     String?
  name         String
  role         String
  signatureKey String   @unique
  contentType  String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

model AdminFile {
  id           String   @id @default(cuid())
  name         String
  s3Key        String   @unique
  contentType  String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy StaffProfile @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
}

// An image embedded in CMS content (the welcome-message rich text). Bytes live
// in S3 under `s3Key`; the editor references the image via `/api/cms/images/<id>`.
// Dimensions are the post-downscale intrinsic size (see `server/cms/image.ts`).
//
// Whether an image is still used is determined by the content itself (the
// `/api/cms/images/<id>` URL inside some `CmsPage.content`), not by a column
// here — so there is no event link to keep in sync. A row whose id appears in
// no content is garbage: an abandoned upload, an image edited out of a message,
// or one whose page was deleted. The GC sweep (`/api/jobs/gc-cms-images`)
// reclaims those, freeing both the row and the S3 object. This reconciliation
// exists because S3 and Postgres cannot commit atomically and an abandoned
// upload fires no server event — it is the safety net, not a substitute for
// correctness on the happy path. `uploadedById` is kept for attribution and is
// SetNull so deleting the author never deletes the image.
model CmsImage {
  id           String   @id @default(cuid())
  s3Key        String   @unique
  contentType  String
  width        Int
  height       Int
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy StaffProfile? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
}

/// Tracking record for generating an onboarding PDF (charter/rules/image-rights)
/// and uploading it to S3. Created in the same transaction as the signature,
/// then generated in the background immediately after (see runOnboardingPdfJob)
/// so the signer isn't blocked. No auto-retry: a failed job stays in "error"
/// with the captured message, re-runnable from /staff/admin/onboarding-pdfs.
model OnboardingPdfJob {
  id           String    @id @default(cuid())
  talentId     String
  documentType String // "charter" | "rules" | "image-rights"
  status       String    @default("pending") // "pending" | "processing" | "success" | "error"
  filePath     String? // S3 key, set on success
  errorMessage String? // captured on failure
  payload      Json // snapshot of generator inputs (studentName, city, signedAt, etc.)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  processedAt  DateTime?

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([talentId])
}

// ─── Broadcasts (envoi en masse mail/SMS) ───

enum BroadcastChannel {
  mail
  sms
}

enum BroadcastStatus {
  queued
  sending
  sent
  partial_failed
  failed
}

enum BroadcastRecipientStatus {
  pending
  sent
  failed
}

enum BroadcastAudience {
  talent
  parent
  dev
  superdev
}

enum BroadcastSourceFilter {
  opened
  not_opened
  all
}

model MessageTemplate {
  id          String           @id @default(cuid())
  /// Stable identity for a seeded *broadcast* template (free-standing, no
  /// EmailActionMapping). Lets `seed-catalogs` upsert these defaults
  /// idempotently without colliding on the non-unique `name`. Null for admin-
  /// and demo-authored templates. Seeded *transactional* defaults need no
  /// seedKey: they are anchored by their EmailActionMapping.actionKey instead.
  seedKey     String?          @unique
  name        String
  channel     BroadcastChannel
  subject     String?
  body        String
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy           bauth_user           @relation("MessageTemplateCreator", fields: [createdById], references: [id])
  broadcasts          Broadcast[]
  emailActionMappings EmailActionMapping[]

  @@index([channel])
}

/// Maps a transactional email action (OTP login, welcome…) to a
/// MessageTemplate. Resolved at send time by `sendActionEmail`. When no
/// row exists for an action, the email is silently skipped (an admin
/// warning surfaces in `/staff/admin/email-actions`). Action keys live in
/// `$lib/domain/emailActions.ts`.
model EmailActionMapping {
  actionKey  String   @id
  templateId String
  updatedAt  DateTime @default(now()) @updatedAt

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Broadcast {
  id                String                 @id @default(cuid())
  name              String
  channel           BroadcastChannel
  templateId        String
  campusId          String
  audience          BroadcastAudience
  eventId           String?
  sourceBroadcastId String?
  sourceFilter      BroadcastSourceFilter?
  filters           Json?
  subjectSnapshot   String?
  bodySnapshot      String
  status            BroadcastStatus        @default(queued)
  createdById       String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  template        MessageTemplate      @relation(fields: [templateId], references: [id])
  campus          Campus               @relation(fields: [campusId], references: [id])
  event           Event?               @relation(fields: [eventId], references: [id])
  sourceBroadcast Broadcast?           @relation("BroadcastRetargeting", fields: [sourceBroadcastId], references: [id])
  retargets       Broadcast[]          @relation("BroadcastRetargeting")
  createdBy       bauth_user           @relation("BroadcastCreator", fields: [createdById], references: [id])
  recipients      BroadcastRecipient[]

  @@index([campusId])
  @@index([eventId])
  @@index([sourceBroadcastId])
  @@index([createdAt])
  @@index([status])
}

model BroadcastRecipient {
  id               String                   @id @default(cuid())
  broadcastId      String
  talentId         String?
  staffUserId      String?
  parentOfTalentId String?
  recipientEmail   String?
  recipientPhone   String?
  status           BroadcastRecipientStatus @default(pending)
  errorMessage     String?
  sentAt           DateTime?
  openedAt         DateTime?
  /// Number of send attempts so far. Capped by orchestrator's MAX_RETRIES.
  retryCount       Int                      @default(0)
  /// When the last send attempt happened. NULL = never tried. Used to gate
  /// retries: a transient failure can be retried after a backoff window.
  lastTriedAt      DateTime?
  createdAt        DateTime                 @default(now())

  broadcast Broadcast   @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  talent    Talent?     @relation("BroadcastRecipientTalent", fields: [talentId], references: [id], onDelete: SetNull)
  staffUser bauth_user? @relation("BroadcastRecipientStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  parentOf  Talent?     @relation("BroadcastRecipientParent", fields: [parentOfTalentId], references: [id], onDelete: SetNull)

  @@index([broadcastId])
  @@index([talentId])
  @@index([parentOfTalentId])
  @@index([staffUserId])
  @@index([openedAt])
  @@index([status])
}

// ─── Interests ───

model Interest {
  id                    String  @id @default(cuid())
  nom                   String  @unique
  emoji                 String?
  kind                  String  @default("general") // "tech" | "general"
  order                 Int
  // Full event-opportunity message for the dev fiche recommendations (REC-005),
  // shown verbatim. When set on a tech interest, a student who picked it gets
  // this exact sentence as a recommendation; null means the interest never
  // triggers one.
  recommendationMessage String?

  talentInterests TalentInterest[]
}

model TalentInterest {
  talentId   String
  interestId String

  talent   Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([talentId, interestId])
  @@index([interestId])
}

// ─── Minigames ───

enum MinigameScoring {
  score
  chrono
}

enum MinigameAttemptStatus {
  pending
  done
  invalid
}

// Host-side curation of the game catalogue: which games (by slug) are in the
// daily rotation and with what weight. Everything *about* a game — its display
// name, level count, scoring mode — is owned by jump-games and read live from
// its `GET /api/games` catalogue (src/lib/server/services/minigameCatalog.ts),
// never duplicated here. A game is in rotation iff it has a row with
// enabled = true; no row means "not curated yet" (off).
model MinigameConfig {
  game      String   @id // jump-games catalogue slug
  weight    Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A daily publication is an append-only fact: it records *what was published*.
// `gameName` and `scoringType` are snapshotted from the catalogue at publish
// time so historical leaderboards stay correct (and renderable) even if the
// game is later renamed or removed from jump-games. `game` is the slug, kept
// as a plain string (no FK) so a publication outlives any config/catalogue
// churn.
model MinigamePublication {
  id          String          @id @default(cuid())
  game        String
  gameName    String
  level       Int
  scoringType MinigameScoring
  publishedAt DateTime        @default(now())
  forcedById  String?

  attempts MinigameAttempt[]

  @@index([publishedAt])
  @@index([game])
}

model MinigameAttempt {
  id            String                @id @default(cuid())
  talentId      String
  publicationId String
  eventId       String?
  campusId      String?
  status        MinigameAttemptStatus @default(pending)
  score         Int?
  chrono        Int?
  valid         Boolean?
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?
  jti           String                @unique
  // XP granted for finishing this attempt (null = none, e.g. an invalid run or
  // a pre-feature row). Source of truth for the award — set once in the
  // callback, so a retried callback can't double-pay.
  xpAwarded     Int?
  // When the talent saw the "+XP" arrival celebration on the dashboard. Null
  // while xpAwarded is set ⇒ a fresh win still to be celebrated (mirrors
  // Talent.welcomeSeenAt). Gates the one-shot float so it can't replay.
  xpSeenAt      DateTime?
  // Bonus XP for placing top-N on the campus board (null = no bonus). Set once
  // in the finish callback, the same way xpAwarded is, from the attempt's rank
  // against the board at that moment — so a retried callback can't double-pay.
  rankXpAwarded Int?
  // One-shot float gate for the rank bonus, mirroring xpSeenAt. The play page
  // floats only the base finish reward, so the rank bonus is celebrated on the
  // next dashboard visit, independently of the finish float.
  rankXpSeenAt  DateTime?

  talent      Talent              @relation(fields: [talentId], references: [id], onDelete: Cascade)
  publication MinigamePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  event       Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campus      Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([talentId, publicationId])
  @@index([eventId, publicationId])
  @@index([campusId, publicationId])
  @@index([publicationId])
}

// Append-only XP ledger. One row per granting fact, so a talent's balance is
// always explainable ("which event gave how much"). Talent.xp is a cached
// projection = SUM(amount), recomputed transactionally on every write — see
// services/xpService.ts. Grants are upserted on (source, sourceId) and deleted
// on reversal (unmark presence, remove participation, onboarding/dev reset), so
// there is never a clamped Math.max() refund to drift out of sync.
model XpGrant {
  id        String        @id @default(cuid())
  talentId  String
  campusId  String?
  source    XpGrantSource
  // Stable dedupe key per source: onboarding→talentId,
  // onboarding_early_bird→talentId (distinct row from the base because `source`
  // differs), minigame→attemptId, minigame_rank→attemptId,
  // reward→`${rewardId}_${talentId}` (one grant per talent per XpReward, see
  // XpReward below), admin_adjustment→null (never deduped: Postgres treats NULLs
  // as distinct under the unique index).
  sourceId  String?
  amount    Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  talent Talent  @relation(fields: [talentId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([talentId])
  @@index([campusId])
  @@index([source])
}

enum XpGrantSource {
  onboarding
  // Bonus layered on `onboarding` for being among the first to finish onboarding
  // in your campus. Its own fact (not a bigger `onboarding` amount) so the base
  // arrival reward stays explainable and the early-bird tier is auditable.
  onboarding_early_bird
  minigame
  // Bonus layered on `minigame` for placing top-N on the campus board, ranked at
  // the moment the talent finishes (per campus). Separate fact from the flat
  // finish reward.
  minigame_rank
  // Grant tied to a named, reusable XpReward (a stage activity scored outside the
  // planning, e.g. a CTF). Its own source so it stays distinct from a raw
  // admin_adjustment correction and is queryable per category. Amount is
  // per-talent (the CTF score), not the activity's difficulty.
  reward
  admin_adjustment
}

// Catalogue of named, reusable XP rewards: one row per scored activity that
// grants XP outside the planning/minigame paths (a CTF, a hackathon...). It is
// the typed, deduplicated identity behind every `reward` XpGrant: the category
// a talent and the staff can later point to, instead of a free-text note copied
// onto each grant. `key` is the stable slug used to (re)provision idempotently
// from a CSV; `awardedOn` is the activity's real date, decoupled from when the
// grant script happens to run. `xpAmount` is set only for fixed-amount rewards;
// it stays null when the amount is per-talent (CTF score), which lives on the
// grant. Campus-scoped when `campusId` is set, global when null.
model XpReward {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  xpAmount  Int?
  campusId  String?
  awardedOn DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([campusId])
}

/// Append-only ledger of OTP login attempts, consumed by
/// `$lib/server/auth/rateLimiter` to cap brute-force on `verify` and mailbomb
/// on `request`. One row per attempt; the limiter counts rows inside the
/// bucket's window for its check. Lives in Postgres (not in-process memory)
/// so horizontally-scaled SvelteKit pods share one ledger and a pod restart
/// cannot reset an attacker's budget. `bucket` is kept as a `String` rather
/// than a Prisma enum because the vocabulary lives in code
/// (`OtpAttemptBucket` in `rateLimiter.ts`); adding a new bucket should not
/// require a schema migration.
model OtpAttempt {
  id        String   @id @default(cuid())
  bucket    String
  email     String
  createdAt DateTime @default(now())

  @@index([bucket, email, createdAt])
  @@index([createdAt])
}

/// Append-only audit ledger of manual auth-identity repairs (see
/// `authIdentityRepairCore.ts`). When an admin (or the Salesforce sync) resolves a
/// login-identity conflict — a talent linked to the wrong `bauth_user` after a
/// Salesforce email change/inversion — the resolution is recorded here as one
/// immutable fact. This is identity surgery on minors' accounts (RGPD), so it
/// must stay explainable and auditable after the fact: who repaired which
/// talent, how, and which accounts were repointed / renamed / dropped. Follows
/// the repo's "facts as rows" convention (cf. XpGrant / OtpAttempt). Never
/// updated.
model AuthIdentityRepair {
  id         String   @id @default(cuid())
  talentId   String
  /// repoint_drop | rename | swap | sever — kept a `String` (the vocabulary
  /// lives in code as `AuthRepairKind`), so a new operation needs no migration.
  kind       String
  /// The account kept / linked after the repair (null for `sever`).
  toUserId   String?
  /// The account renamed-from or hard-dropped by the repair (null where N/A).
  fromUserId String?
  /// Emails captured at repair time, for the trail — the rows they describe may
  /// be gone by the time anyone reads this.
  fromEmail  String?
  toEmail    String?
  /// `bauth_user.id` of the admin who ran it, or `'sync'` when the Salesforce
  /// sync auto-resolved it. Plain `String` (no FK) so a non-user actor like the
  /// sync still records, and so the row survives the actor's own later deletion.
  resolvedBy String
  resolvedAt DateTime @default(now())

  @@index([talentId])
  @@index([resolvedAt])
}

/// Which half of the curated catalogue a token may call.
///
///   core        the Academy core team: every operation, and writes when the
///               token was minted with `writeEnabled`.
///   leadership  national leadership (tier 2): only the operations that opt in
///               (`leadership: true` in the catalogue), read-only by
///               construction. Figures and rankings, never rows with ids,
///               never an operational internal.
///
/// core ⊇ leadership, so widening leadership is always an explicit opt-in on an
/// operation and never a side effect of adding one.
enum AdminApi_TokenTier {
  core
  leadership
}

/// A nominative, revocable bearer credential an admin mints for a machine caller
/// (the MCP server, a script) so it can reach the curated admin API without
/// borrowing a browser session. The secret is displayed once at creation and
/// persisted only as a hash, so a database dump carries no usable credential.
model AdminApi_Token {
  id              String             @id @default(cuid())
  /// `bauth_user.id` of the owning admin. Cascade on purpose: a token is that
  /// human's own credential and must never outlive their account.
  ///
  /// A leadership token is minted by an admin FOR someone with no Jump account
  /// (national leadership has none), so this names the admin who issued it and
  /// stays accountable for it; `label` names the human actually holding it.
  staffUserId     String
  /// Human label typed at creation ("Copilot Edouard", "script rapport
  /// mensuel"), so a token can be told apart before being revoked. On a
  /// leadership token it must name the holder, since `staffUserId` cannot.
  label           String
  /// What this token may call. Fixed at mint: re-scoping a credential already
  /// handed out is how a narrow token quietly becomes a wide one.
  tier            AdminApi_TokenTier @default(core)
  /// Whether this token may call mutating operations. One boolean, not a scope
  /// vocabulary: there are two classes of caller today and a speculative scope
  /// array would be surface without a user. A read token stays read-only for
  /// life; writing needs a token minted for it. Never true on a leadership
  /// token (tier 2 is read-only by construction).
  writeEnabled    Boolean            @default(false)
  /// sha256 hex of the secret. Unique, so verifying a bearer is one indexed
  /// lookup instead of a scan-and-compare over every row.
  tokenHash       String             @unique
  createdAt       DateTime           @default(now())
  /// Stamped on every accepted call, so a token nobody uses is visible before
  /// someone has to guess whether cutting it breaks something.
  lastUsedAt      DateTime?
  /// Revocation is a timestamp, not a delete: the call log keeps pointing at the
  /// token that produced it.
  revokedAt       DateTime?
  /// `bauth_user.id` of the admin who revoked it, null while it is live. Plain
  /// `String` (no FK), like `AdminApi_Call.actorUserId`, so the fact survives
  /// that admin's own account being deleted. Recorded because the inventory is
  /// shared by every admin: a revocation is not necessarily the owner's own.
  revokedByUserId String?

  staffUser bauth_user      @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  calls     AdminApi_Call[]

  @@index([staffUserId])
}

/// Append-only log of every curated-admin-API call, by token or by admin
/// session. Facts as rows, no projection and no UI: the seminar's design rule is
/// that audit replaces up-front restriction, and that reading what people
/// actually ask for is free product research. Also the source of the per-token
/// daily quota (counted, not stored).
model AdminApi_Call {
  id          String   @id @default(cuid())
  /// Null when an admin session drove the call (same operations, browser
  /// caller), and null once the owning account is deleted. `actorUserId` still
  /// answers "who".
  tokenId     String?
  /// `bauth_user.id` of the human behind the call. Plain `String` (no FK), like
  /// `AuthIdentityRepair.resolvedBy`, so the fact survives that account's own
  /// later deletion.
  actorUserId String
  /// Operation name, the same vocabulary as the MCP tool names
  /// (`stats_events_overview`, ...). A plain String so a new operation needs no
  /// migration; the catalogue lives in `$lib/server/adminApi/operations.ts`.
  operation   String
  /// The validated params. PII-free by construction: this tier serves
  /// aggregates and configuration state, so its params are ids and school years.
  params      Json?
  /// Status the caller got (200, 403, 429, ...), so refusals are auditable too,
  /// not just successes.
  status      Int
  /// State of what the call changed, before and after. Written by mutating
  /// operations only (null on every read), which is what turns this log from a
  /// request trail into a change history. Same table, because a write IS a
  /// call and one log is the whole point.
  ///
  /// Never the raw row: each write decides what to record, and anything
  /// carrying a talent's own words is reduced to a non-identifying summary
  /// first (see the interview reset), so the retention window cannot become a
  /// back door around the tier's PII rule.
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  token AdminApi_Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([tokenId, createdAt])
  @@index([createdAt])
}
