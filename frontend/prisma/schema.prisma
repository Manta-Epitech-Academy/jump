generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───

// Difficulty stored as plain string: "Débutant", "Intermédiaire", "Avancé"
// This avoids enum mapping issues between Prisma TS names and French display values.

// StudentLevel stored as plain string: "Novice", "Apprentice", "Expert"
// Niveau stored as plain string from the canonical catalogue in
// `src/lib/domain/niveau.ts` (NIVEAUX); values match jump-sf-worker's ClassLevel.

enum StepStatus {
  active
  needs_help
  completed
}

enum UnlockSource {
  student
  staff
}

enum ActivityType {
  atelier
  conference
  quiz
  orga
  special
  break
}

enum StaffRole {
  admin
  superdev
  dev
  peda
  manta
}

enum InterviewStatus {
  planned
  completed
  cancelled
}

enum InterviewRecommendation {
  epitech_orientation_forte
  a_explorer
  autre_filiere
  a_determiner
}

enum ParticipationVerdict {
  comfortable
  progressing
  struggling
}

enum ParticipationContextTag {
  helped_others
  disengaged
}

// ─── Auth (BetterAuth managed) ───

model bauth_user {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions                  bauth_session[]
  accounts                  bauth_account[]
  staffProfile              StaffProfile?
  talent                    Talent?
  invitationsIssued         StaffInvitation[]     @relation("StaffInvitationInvitedBy")
  cmsPages                  CmsPage[]
  ticketsAuthored           Ticket[]              @relation("TicketAuthor")
  ticketMessages            TicketMessage[]
  outlookSyncs              OutlookCalendarSync[]
  broadcastsCreated         Broadcast[]           @relation("BroadcastCreator")
  templatesCreated          MessageTemplate[]     @relation("MessageTemplateCreator")
  broadcastsReceivedAsStaff BroadcastRecipient[]  @relation("BroadcastRecipientStaff")
}

model bauth_session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  impersonatedBy String?

  user bauth_user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model bauth_account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user bauth_user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model bauth_verification {
  id         String   @id @default(cuid())
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Domain Profiles ───

model StaffProfile {
  id        String     @id @default(cuid())
  userId    String     @unique
  campusId  String?
  staffRole StaffRole?
  discordId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user                    bauth_user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                  Campus?                 @relation(fields: [campusId], references: [id])
  eventMantas             EventManta[]
  verdictsAuthored        ParticipationActivity[] @relation("VerdictAuthor")
  interviewsConducted     Interview[]
  adminFiles              AdminFile[]
  subjectVersionsImported SubjectVersion[]
  observableValidations   TalentObservableState[]

  @@index([campusId])
}

model StaffInvitation {
  id              String    @id @default(cuid())
  email           String    @unique
  campusId        String?
  staffRole       StaffRole
  invitedByUserId String
  createdAt       DateTime  @default(now())

  campus    Campus?    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  invitedBy bauth_user @relation("StaffInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

model Talent {
  id                          String    @id @default(cuid())
  userId                      String?   @unique
  email                       String?   @unique
  nom                         String
  prenom                      String
  niveau                      String?
  xp                          Int       @default(0)
  eventsCount                 Int       @default(0)
  charterAcceptedAt           DateTime?
  techInterestsValidatedAt    DateTime?
  generalInterestsValidatedAt DateTime?
  interestsRecapSeenAt        DateTime?
  rulesSignedAt               DateTime?
  imageRightsSignedAt         DateTime?
  imageRightsSignerName       String?
  infoValidatedAt             DateTime?
  highSchoolValidatedAt       DateTime?
  parentsValidatedAt          DateTime?
  processingCompletedAt       DateTime?
  schoolId                    String?
  // Free-text fallback used only when the talent's lycée has no UAI (so no
  // canonical `School` row exists). When `schoolId` is set this stays null.
  highSchoolNameManual        String?
  charterFilePath             String?
  rulesFilePath               String?
  imageRightsFilePath         String?
  badges                      Json?
  parentEmail                 String?
  parentNom                   String?
  parentPrenom                String?
  parentPhone                 String?
  phone                       String?
  civilite                    String?
  parentType                  String?
  parentCivilite              String?
  parent2Type                 String?
  parent2Civilite             String?
  parent2Nom                  String?
  parent2Prenom               String?
  parent2Email                String?
  parent2Phone                String?
  hasLaptop                   Boolean   @default(false)
  setupDescription            String?
  equipmentValidatedAt        DateTime?
  interestsFreeText           String?
  discordId                   String?   @unique
  externalId                  String?   @unique
  lastSyncedAt                DateTime?
  lastActiveAt                DateTime?
  welcomeSeenAt               DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user               bauth_user?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  participations     Participation[]
  stepsProgress      StepsProgress[]
  portfolioItems     PortfolioItem[]
  interviews         Interview[]
  observableStates   TalentObservableState[]
  competenceStates   TalentCompetenceState[]
  quizAttempts       TalentQuizAttempt[]
  reminders          OnboardingReminder[]
  pdfJobs            OnboardingPdfJob[]
  minigameAttempts   MinigameAttempt[]
  interests          TalentInterest[]
  xpGrants           XpGrant[]
  school             School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sfImport           TalentSfImport?
  broadcastsReceived BroadcastRecipient[]    @relation("BroadcastRecipientTalent")
  broadcastsAsParent BroadcastRecipient[]    @relation("BroadcastRecipientParent")
  deletionRequests   TalentDeletionRequest[]

  @@index([xp])
  @@index([schoolId])
}

/// Canonical high-school directory, keyed by the national UAI (RNE) code.
/// Rows are created lazily the first time a UAI is seen — Salesforce sync or a
/// talent picking from the annuaire — then enriched from the official
/// éducation-nationale annuaire. Only schools actually attended by a talent ever
/// land here, never the full ~69k national dataset.
model School {
  id         String    @id @default(cuid())
  uai        String    @unique
  name       String
  city       String?
  postalCode String?
  inseeCode  String?
  /// null = created from a fallback name (annuaire lookup pending or failed); a
  /// backfill pass fills name/city/codes once the annuaire resolves the UAI.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  talents     Talent[]
  sfClaimedBy TalentSfImport[]
}

/// 1:1 mirror of what Salesforce last claimed for a talent — the anti-corruption
/// boundary. Upserted by the worker sync (only when the inbound payload differs),
/// never written by onboarding. Reconciliation compares this against the `Talent`
/// row: a divergence on a talent-confirmed field is a conflict. School is compared
/// by FK (`sfSchoolId` vs `Talent.schoolId`), scalars value-by-value. `niveau` is
/// kept for a faithful snapshot but is SF-owned, never reconciled.
model TalentSfImport {
  talentId   String   @id
  nom        String?
  prenom     String?
  phone      String?
  civilite   String?
  niveau     String?
  sfSchoolId String?
  syncedAt   DateTime @updatedAt

  talent   Talent  @relation(fields: [talentId], references: [id], onDelete: Cascade)
  sfSchool School? @relation(fields: [sfSchoolId], references: [id], onDelete: SetNull)

  @@index([sfSchoolId])
}

// RGPD erasure as a fact log, not an instant destructive action. A talent's
// "delete my account" no longer wipes rows on the spot — it appends a pending
// request here. Staff fulfil it (→ anonymisation, the real erasure mechanism)
// or reject it; the talent can withdraw their own pending request. Each
// transition is a status on the same row, so the request doubles as the audit
// trail of *when* and *by whom* an account was erased. See xpService for the
// same facts-as-rows shape.
enum TalentDeletionRequestStatus {
  pending
  fulfilled
  rejected
  cancelled
}

model TalentDeletionRequest {
  id             String                      @id @default(cuid())
  talentId       String
  status         TalentDeletionRequestStatus @default(pending)
  // Optional free-text the talent leaves when asking ("I'm leaving school"…).
  reason         String?
  requestedAt    DateTime                    @default(now())
  // Set on any terminal transition (fulfilled / rejected / cancelled).
  resolvedAt     DateTime?
  // bauth_user.id of the admin who fulfilled/rejected; null for self-withdrawal.
  resolvedBy     String?
  // Staff note on a rejection. Shown to the talent as the official reason
  // (RGPD art. 12(4): the data subject must be told why erasure was declined),
  // so it's written for them, not as an internal shorthand.
  resolutionNote String?
  // When the talent dismissed the rejection notice in their settings. Until
  // set, the notice keeps showing; re-requesting (a new row) also clears it.
  acknowledgedAt DateTime?

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([talentId])
}

// ─── Domain Tables ───

model Campus {
  id           String   @id @default(cuid())
  name         String   @unique
  externalName String?  @unique
  timezone     String   @default("Europe/Paris")
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfiles     StaffProfile[]
  events            Event[]
  themes            Theme[]
  participations    Participation[]
  activityTemplates ActivityTemplate[]
  interviews        Interview[]
  invitations       StaffInvitation[]
  featureFlags      CampusFeatureFlag[]
  broadcasts        Broadcast[]
  minigameAttempts  MinigameAttempt[]
  xpGrants          XpGrant[]
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String
  eventId   String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  bauth_user @relation(fields: [updatedBy], references: [id])

  @@unique([slug, eventId])
  @@index([eventId])
}

model Theme {
  id        String   @id @default(cuid())
  nom       String
  campusId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus                 Campus?                 @relation(fields: [campusId], references: [id])
  events                 Event[]
  activityTemplateThemes ActivityTemplateTheme[]
  activityThemes         ActivityTheme[]

  @@unique([nom, campusId])
}

model ActivityTemplate {
  id               String       @id @default(cuid())
  nom              String
  description      String?
  difficulte       String?
  activityType     ActivityType
  isDynamic        Boolean      @default(false)
  campusId         String?
  link             String?
  content          String?
  contentStructure Json?
  defaultDuration  Int?
  subjectId        String?
  subjectVersionId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  campus                 Campus?                 @relation(fields: [campusId], references: [id])
  activityTemplateThemes ActivityTemplateTheme[]
  planningTemplateSlots  PlanningTemplateSlot[]
  subject                Subject?                @relation(fields: [subjectId], references: [id])
  subjectVersion         SubjectVersion?         @relation(fields: [subjectVersionId], references: [id])

  @@index([subjectId])
  @@index([subjectVersionId])
}

model ActivityTemplateTheme {
  activityTemplateId String
  themeId            String

  activityTemplate ActivityTemplate @relation(fields: [activityTemplateId], references: [id], onDelete: Cascade)
  theme            Theme            @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([activityTemplateId, themeId])
}

model Planning {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]
}

model TimeSlot {
  id         String   @id @default(cuid())
  planningId String
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  planning Planning  @relation(fields: [planningId], references: [id], onDelete: Cascade)
  activity Activity?

  @@index([planningId])
}

model Activity {
  id               String       @id @default(cuid())
  nom              String
  description      String?
  difficulte       String?
  activityType     ActivityType
  isDynamic        Boolean      @default(false)
  link             String?
  content          String?
  contentStructure Json?
  timeSlotId       String       @unique
  templateId       String?
  subjectVersionId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  timeSlot                TimeSlot                @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  activityThemes          ActivityTheme[]
  participationActivities ParticipationActivity[]
  stepsProgress           StepsProgress[]
  portfolioItems          PortfolioItem[]
  subjectVersion          SubjectVersion?         @relation(fields: [subjectVersionId], references: [id])

  @@index([templateId])
  @@index([subjectVersionId])
