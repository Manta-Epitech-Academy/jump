{
  "name": "jump",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "db:generate": "prisma generate && bun run scripts/gen-db-erd.ts",
    "db:migrate": "prisma migrate dev && bun run scripts/gen-db-erd.ts",
    "db:studio": "prisma studio",
    "db:erd": "bun run scripts/gen-db-erd.ts",
    "garage:generate": "bun run scripts/configure-garage.ts",
    "setup:worktree": "sh scripts/setup-worktree.sh",
    "dev": "bun --bun --env-file=../.env vite dev",
    "build": "bun --bun --env-file=../.env vite build",
    "preview": "bun --bun --env-file=../.env vite preview",
    "start": "bun --env-file=../.env ./build/index.js",
    "prepare": "cd .. && git config core.hooksPath .githooks || true && cd frontend && svelte-kit sync || echo ''",
    "postinstall": "prisma generate",
    "check": "KIT_OUTDIR=.svelte-kit-check svelte-kit sync && KIT_OUTDIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json",
    "check:watch": "KIT_OUTDIR=.svelte-kit-check svelte-kit sync && KIT_OUTDIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:db": "sh scripts/with-test-db.sh",
    "test:integration": "sh scripts/with-test-db.sh vitest run --project integration",
    "test:schema-drift": "sh scripts/with-test-db.sh sh scripts/check-schema-drift.sh",
    "test:e2e": "TEST_DB_SUITE=e2e sh scripts/with-test-db.sh playwright test",
    "test:e2e:ui": "TEST_DB_SUITE=e2e sh scripts/with-test-db.sh playwright test --ui",
    "lint:design": "bun run scripts/lint-design.ts",
    "lint:tests": "bun run scripts/lint-tests.ts",
    "lint:scripts": "sh ../scripts/check-exec-bits.sh",
    "verify": "bun run lint:scripts && bun run lint && bun run lint:design && bun run lint:tests && bun run check && bun run test && bun run test:integration && bun run test:schema-drift && bun run test:e2e"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.35.0",
    "@playwright/test": "^1.62.1",
    "@prisma/internals": "^7.10.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ejs": "^3.1.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "^7.10.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@smithy/node-http-handler": "^4.11.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/bun": "^1.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.5",
    "better-auth": "^1.7.2",
    "canvas-confetti": "^1.9.4",
    "ejs": "^6.0.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.5",
    "isomorphic-dompurify": "^3.23.0",
    "jose": "^6.2.10",
    "libphonenumber-js": "^1.13.12",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.26",
    "puppeteer": "^25.9.0",
    "qrcode": "^1.5.4",
    "resend": "^6.24.0",
    "sveltekit-superforms": "^2.30.2",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "overrides": {
    "ts-deepmerge": "^8.0.0",
    "deepmerge-ts": "^8.0.0",
    "basic-ftp": "^5.3.1",
    "picomatch": "^4.0.4",
    "cookie": "^0.7.0",
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.34",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.7.0",
    "uuid": "^14.0.0",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18",
    "valibot": "^1.4.2",
    "ip-address": "^10.3.1",
    "joi": "^18.2.1",
    "kysely": "^0.28.17",
    "devalue": "^5.8.1",
    "esbuild": "^0.28.1",
    "svelte": "^5.55.7",
    "vite": "^7.3.5",
    "ws": "^8.21.0",
    "dompurify": "^3.4.13",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.2.0",
    "undici": "^7.29.0"
  }
}
