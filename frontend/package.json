{
  "name": "jump",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "db:generate": "prisma generate && bun run scripts/gen-db-erd.ts",
    "db:migrate": "prisma migrate dev && bun run scripts/gen-db-erd.ts",
    "db:studio": "prisma studio",
    "db:erd": "bun run scripts/gen-db-erd.ts",
    "garage:generate": "bun run scripts/configure-garage.ts",
    "setup:worktree": "sh scripts/setup-worktree.sh",
    "dev": "bun --bun --env-file=../.env vite dev",
    "build": "bun --bun --env-file=../.env vite build",
    "preview": "bun --bun --env-file=../.env vite preview",
    "start": "bun --env-file=../.env ./build/index.js",
    "prepare": "cd .. && git config core.hooksPath .githooks || true && cd frontend && svelte-kit sync || echo ''",
    "postinstall": "prisma generate",
    "check": "KIT_OUTDIR=.svelte-kit-check svelte-kit sync && KIT_OUTDIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json",
    "check:watch": "KIT_OUTDIR=.svelte-kit-check svelte-kit sync && KIT_OUTDIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "bun --env-file=.env.test vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.21.0",
    "@playwright/test": "^1.61.0",
    "@prisma/internals": "^7.8.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/ejs": "^3.1.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.9",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "^7.8.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
