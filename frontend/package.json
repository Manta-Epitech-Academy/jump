{
  "name": "jump",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "db:generate": "prisma generate && bun run scripts/gen-db-erd.ts",
    "db:migrate": "prisma migrate dev && bun run scripts/gen-db-erd.ts",
    "db:studio": "prisma studio",
    "db:erd": "bun run scripts/gen-db-erd.ts",
    "garage:generate": "bun run scripts/configure-garage.ts",
    "setup:worktree": "sh scripts/setup-worktree.sh",
    "dev": "bun --bun --env-file=../.env vite dev",
    "build": "bun --bun --env-file=../.env vite build",
    "preview": "bun --bun --env-file=../.env vite preview",
    "start": "bun --env-file=../.env ./build/index.js",
    "prepare": "cd .. && git config core.hooksPath .githooks || true && cd frontend && svelte-kit sync || echo ''",
    "postinstall": "prisma generate",
    "check": "KIT_OUTDIR=.svelte-kit-check svelte-kit sync && KIT_OUTDIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json && tsc -p scripts/seed/tsconfig.json",
    "check:watch": "KIT_OUTDIR=.svelte-kit-check svelte-kit sync && KIT_OUTDIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:db": "sh scripts/with-test-db.sh",
    "test:integration": "sh scripts/with-test-db.sh vitest run --project integration",
    "test:schema-drift": "sh scripts/with-test-db.sh sh scripts/check-schema-drift.sh",
    "seed": "bun run scripts/seed/index.ts",
    "test:seed": "TEST_DB_SUITE=seed sh scripts/with-test-db.sh sh scripts/check-seed-profiles.sh",
    "test:e2e": "TEST_DB_SUITE=e2e sh scripts/with-test-db.sh playwright test",
    "test:e2e:ui": "TEST_DB_SUITE=e2e sh scripts/with-test-db.sh playwright test --ui",
    "lint:design": "bun run scripts/lint-design.ts",
    "lint:tests": "bun run scripts/lint-tests.ts",
    "lint:prose": "bun run scripts/lint-prose.ts",
    "lint:scripts": "sh ../scripts/check-exec-bits.sh",
    "verify": "bun run lint:scripts && bun run lint && bun run lint:design && bun run lint:tests && bun run lint:prose && bun run check && bun run test && bun run test:integration && bun run test:schema-drift && bun run test:seed && bun run test:e2e"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.62.0",
    "@playwright/test": "^1.64.1",
    "@prisma/internals": "^7.10.1",
    "@scalar/api-reference": "1.72.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ejs": "^3.1.5",
    "@types/jsdom": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.12",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@hono/mcp": "^0.3.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@smithy/node-http-handler": "^4.13.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.9",
    "better-auth": "^1.7.14",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.17",
    "ejs": "^6.0.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.14",
    "isomorphic-dompurify": "^3.23.0",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "libphonenumber-js": "^1.13.15",
    "marked": "^18.1.2",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.32",
    "puppeteer": "^25.16.0",
    "qrcode": "^1.5.4",
    "resend": "^6.35.0",
    "sveltekit-superforms": "^2.31.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ts-deepmerge": "^8.0.0",
    "deepmerge-ts": "^8.0.0",
    "basic-ftp": "^5.3.1",
    "picomatch": "^4.0.4",
    "cookie": "^0.7.0",
    "@hono/node-server": "^2.0.11",
    "hono": "^4.13.7",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.9",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.7.0",
    "uuid": "^14.0.0",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18",
    "valibot": "^1.4.2",
    "ip-address": "^10.7.4",
    "joi": "^18.2.6",
    "kysely": "^0.28.17",
    "devalue": "^5.9.3",
    "esbuild": "^0.28.1",
    "svelte": "^5.55.7",
    "vite": "^8.2.4",
    "ws": "^8.21.0",
    "dompurify": "^3.4.17",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.2.0",
    "undici": "^7.30.1",
    "mysql2": "^3.24.2",
    "qs": "^6.16.1",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.6",
    "@ai-sdk/provider-utils": "^4.0.33"
  }
}
